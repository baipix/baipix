---
import PixelIcon from './PixelIcon.astro';
import SectionHead from './SectionHead.astro';

const base = import.meta.env.BASE_URL;
const ARROW = ['...#...', '..#....', '.#.....', '#######', '.#.....', '..#....', '...#...'];
const ARROW_RIGHT = ARROW.map((r) => [...r].reverse().join(''));
const CROSS = ['#.....#', '.#...#.', '..#.#..', '...#...', '..#.#..', '.#...#.', '#.....#'];

// Captured from the editor itself, on drawings from the gallery and a few made for the occasion.
const shots = [
  {
    file: 'boards',
    title: 'Several boards in one file',
    text: 'The four seasons of a scene side by side, each board with its own layers, and a floating preview of the one you work on.',
  },
  {
    file: 'iso',
    title: 'Isometric volumes',
    text: 'Boxes, cylinders standing or lying, stairs and ramps on an isometric grid, with outlines, bevels and a color per face.',
  },
  {
    file: 'components',
    title: 'Components',
    text: 'One banana, five instances in their own groups and colors. Change the component, and every copy follows.',
  },
  {
    file: 'gradient',
    title: 'Gradients in palette colors',
    text: 'A radial gradient on a Game Boy screen, dithered in its four greens and nothing else.',
  },
  {
    file: 'tile',
    title: 'Seamless tiles',
    text: 'Tile preview repeats the drawing all around it, and strokes wrap around the edges.',
  },
  {
    file: 'jumble',
    title: 'Rework without new colors',
    text: 'Blur, Jumble and Liquify reshape a painting and keep its palette as it is.',
  },
  {
    file: 'picker',
    title: 'An eyedropper with a loupe',
    text: 'Pick a color from a magnified loupe with its hex code, while the preview shows the whole drawing.',
  },
  {
    file: 'gap',
    title: 'Pixel gap',
    text: 'Space pixels apart for an LED look, right on the canvas and in the SVG export.',
  },
];
---

<section id="screenshots" class="screenshots container">
  <SectionHead label="Screenshots" />
  <h2>See it at work.</h2>
  <div class="shot-grid">
    {shots.map((s) => (
      <figure class="tile">
        <a
          href={`${base}screenshots/${s.file}.webp`}
          data-zoom
          data-title={s.title}
          data-text={s.text}
          aria-label={`${s.title}, full size`}
        >
          <img
            src={`${base}screenshots/${s.file}.webp`}
            width="1600"
            height="891"
            alt={`${s.title}: ${s.text}`}
            loading="lazy"
            decoding="async"
          />
        </a>
        <figcaption>
          <h3>{s.title}</h3>
          <p class="muted">{s.text}</p>
        </figcaption>
      </figure>
    ))}
  </div>
  <dialog class="zoom" aria-label="Screenshots">
    <figure class="zoom-frame">
      <img alt="" />
      <figcaption class="zoom-caption">
        <span class="zoom-text">
          <strong></strong> <span></span>
        </span>
        <span class="zoom-count"></span>
      </figcaption>
    </figure>
    <button type="button" class="zoom-btn zoom-prev" data-step="-1" aria-label="Previous screenshot">
      <PixelIcon rows={ARROW} size={14} />
    </button>
    <button type="button" class="zoom-btn zoom-next" data-step="1" aria-label="Next screenshot">
      <PixelIcon rows={ARROW_RIGHT} size={14} />
    </button>
    <button type="button" class="zoom-btn zoom-close" aria-label="Close">
      <PixelIcon rows={CROSS} size={14} />
    </button>
  </dialog>
</section>

<script>
  // A screenshot opens full size over the page, its caption on it. The arrow keys (or the side
  // buttons) go through the others; Escape, the close button or a click beside it closes it.
  const dialog = document.querySelector<HTMLDialogElement>('.screenshots .zoom')!;
  const big = dialog.querySelector('img')!;
  const title = dialog.querySelector('strong')!;
  const text = dialog.querySelector('.zoom-text > span')!;
  const count = dialog.querySelector('.zoom-count')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.screenshots [data-zoom]')];
  let current = 0;
  const show = (i: number) => {
    current = (i + links.length) % links.length;
    const link = links[current];
    big.src = link.href;
    big.alt = link.querySelector('img')!.alt;
    title.textContent = link.dataset.title ?? '';
    text.textContent = link.dataset.text ?? '';
    count.textContent = `${current + 1} / ${links.length}`;
  };
  links.forEach((link, i) =>
    link.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      show(i);
      dialog.showModal();
    }),
  );
  for (const button of dialog.querySelectorAll<HTMLButtonElement>('[data-step]'))
    button.addEventListener('click', () => show(current + Number(button.dataset.step)));
  dialog.querySelector('.zoom-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
      e.preventDefault();
      show(current + (e.key === 'ArrowRight' ? 1 : -1));
    }
  });
  // The dialog fills the screen: a click on it, not on the picture or a button, is beside it.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  .screenshots {
    padding-top: 120px;
  }
  h2 {
    margin-top: 40px;
  }
  /* Shared borders, like the feature grid. */
  .shot-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 40px;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  @media (max-width: 720px) {
    .shot-grid {
      grid-template-columns: 1fr;
    }
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
    padding: 20px 20px 28px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .tile a {
    display: block;
    background: var(--surface);
    cursor: zoom-in;
  }
  .tile img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }
  .tile a:focus-visible {
    outline: 2px solid var(--accent, currentColor);
    outline-offset: 2px;
  }
  .tile figcaption {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 0 4px;
  }
  h3 {
    font-size: 18px;
    letter-spacing: -0.01em;
  }
  .zoom {
    width: 100vw;
    max-width: none;
    height: 100vh;
    max-height: none;
    padding: 0;
    border: 0;
    background: transparent;
  }
  .zoom[open] {
    display: grid;
    place-items: center;
  }
  .zoom::backdrop {
    background: rgb(0 0 0 / 0.82);
  }
  .zoom-frame {
    position: relative;
    margin: 0;
    max-width: min(1600px, calc(100vw - 144px));
  }
  .zoom-frame img {
    display: block;
    max-width: 100%;
    max-height: calc(100vh - 48px);
  }
  /* The caption sits on the picture's bottom edge, in a see-through frame. */
  .zoom-caption {
    position: absolute;
    right: 16px;
    bottom: 16px;
    left: 16px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: 14px 18px;
    border: 1px solid rgb(255 255 255 / 0.14);
    background: rgb(15 15 17 / 0.72);
    backdrop-filter: blur(10px);
    color: #f2f2f0;
    font-size: 15px;
    line-height: 1.5;
  }
  .zoom-text span {
    color: rgb(242 242 240 / 0.72);
  }
  .zoom-count {
    flex: none;
    color: rgb(242 242 240 / 0.6);
    font: 400 13px/1 var(--mono);
  }
  .zoom-btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 255 255 / 0.18);
    background: rgb(15 15 17 / 0.6);
    color: #f2f2f0;
    cursor: pointer;
  }
  .zoom-btn:hover {
    background: rgb(40 40 44 / 0.9);
  }
  .zoom-prev {
    top: 50%;
    left: 24px;
    translate: 0 -50%;
  }
  .zoom-next {
    top: 50%;
    right: 24px;
    translate: 0 -50%;
  }
  .zoom-close {
    top: 24px;
    right: 24px;
  }
  /* On a phone, the caption goes under the picture and the buttons under it. */
  @media (max-width: 720px) {
    .zoom-frame {
      max-width: calc(100vw - 32px);
    }
    .zoom-caption {
      position: static;
      flex-direction: column;
      gap: 8px;
    }
    .zoom-prev,
    .zoom-next {
      top: auto;
      bottom: 24px;
      translate: none;
    }
  }
</style>
