---
/**
 * A word that changes, drawn in a small pixel typeface, to end a heading. The first word is the
 * real text (hidden on screen, read by search engines and screen readers); the drawn words take
 * turns, revealed row by row. The box keeps the width of the longest word, so nothing moves.
 */
interface Props {
  words: string[];
  /** End each word with a square pixel period, right after its last letter. */
  period?: boolean;
}
const { words, period = false } = Astro.props;

/*
 * Lowercase glyphs on a 5×9 grid: rows 0–1 for ascenders, 2–6 for the x-height (row 6 sits on
 * the baseline), 7–8 for descenders.
 */
const GLYPHS: Record<string, string[]> = {
  a: ['.....', '.....', '.###.', '....#', '.####', '#...#', '.####', '.....', '.....'],
  e: ['.....', '.....', '.###.', '#...#', '#####', '#....', '.###.', '.....', '.....'],
  f: ['..##.', '.#...', '####.', '.#...', '.#...', '.#...', '.#...', '.....', '.....'],
  h: ['#....', '#....', '####.', '#...#', '#...#', '#...#', '#...#', '.....', '.....'],
  n: ['.....', '.....', '####.', '#...#', '#...#', '#...#', '#...#', '.....', '.....'],
  p: ['.....', '.....', '####.', '#...#', '#...#', '#...#', '####.', '#....', '#....'],
  r: ['.....', '.....', '#.##.', '##..#', '#....', '#....', '#....', '.....', '.....'],
  s: ['.....', '.....', '.####', '#....', '.###.', '....#', '####.', '.....', '.....'],
  t: ['.#...', '.#...', '####.', '.#...', '.#...', '.#..#', '..##.', '.....', '.....'],
  u: ['.....', '.....', '#...#', '#...#', '#...#', '#..##', '.##.#', '.....', '.....'],
  y: ['.....', '.....', '#...#', '#...#', '#...#', '#...#', '.####', '....#', '.###.'],
};
const ROWS = 9;
const letters = (word: string) => word.length * 6 - 1;
// The period: 2×2 pixels on the baseline, one pixel after the word.
const width = (word: string) => letters(word) + (period ? 3 : 0);
const path = (word: string) =>
  [...word]
    .flatMap((ch, i) =>
      GLYPHS[ch].flatMap((row, y) => [...row].map((c, x) => (c === '#' ? `M${i * 6 + x} ${y}h1v1h-1z` : ''))),
    )
    .join('') + (period ? `M${letters(word) + 1} 5h2v2h-2z` : '');
const widest = Math.max(...words.map(width));
---

<span class="pixel-words" style={`--cols: ${widest}`}>
  <span class="sr-only">{words[0]}</span>
  {words.map((word, i) => (
    <svg
      class:list={['pixel-word', { 'is-on': i === 0 }]}
      viewBox={`0 0 ${width(word)} ${ROWS}`}
      style={`--w: ${width(word)}`}
      shape-rendering="crispEdges"
      aria-hidden="true"
    >
      <path fill="currentColor" d={path(word)} />
    </svg>
  ))}
</span>

<script>
  // Every 2.2 s, the next word comes in row by row over the current one, once per page.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  for (const box of document.querySelectorAll<HTMLElement>('.pixel-words')) {
    if (box.dataset.playing || reduced.matches) continue;
    box.dataset.playing = 'true';
    const words = [...box.querySelectorAll<SVGElement>('.pixel-word')];
    let current = 0;
    let timer = 0;
    const next = () => {
      const from = words[current];
      current = (current + 1) % words.length;
      const to = words[current];
      to.classList.add('is-on');
      to.animate([{ clipPath: 'inset(0 0 100% 0)' }, { clipPath: 'inset(0 0 0 0)' }], {
        duration: 360,
        easing: 'steps(9, end)',
      });
      from.animate([{ clipPath: 'inset(0 0 0 0)' }, { clipPath: 'inset(100% 0 0 0)' }], {
        duration: 360,
        easing: 'steps(9, end)',
      }).onfinish = () => from.classList.remove('is-on');
    };
    new IntersectionObserver(([entry]) => {
      clearInterval(timer);
      if (entry.isIntersecting) timer = window.setInterval(next, 2200);
    }).observe(box);
  }
</script>

<style>
  /*
   * One art pixel is a tenth of the font size: the x-height is half an em, like the text around.
   * The box is as wide as the longest word and sits on the baseline (descenders below it).
   */
  .pixel-words {
    position: relative;
    display: inline-block;
    width: calc(var(--cols) * 0.1em);
    height: 0.9em;
    vertical-align: -0.2em;
  }
  .pixel-word {
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--w) * 0.1em);
    height: 0.9em;
    visibility: hidden;
  }
  .pixel-word.is-on {
    visibility: visible;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
