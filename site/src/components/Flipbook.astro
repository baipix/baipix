---
/**
 * Plays an animation's frames, each for its own duration, with the strip of frames under it as in the
 * editor's timeline, the one shown outlined. With reduced motion, the first frame stays; the button
 * plays it anyway.
 */
interface Props {
  frames: { svg: string; duration: number }[];
  label: string;
}
const { frames, label } = Astro.props;
---

<div class="flipbook" data-flipbook data-durations={JSON.stringify(frames.map((f) => f.duration))}>
  <div class="flipbook-stage" role="img" aria-label={label}>
    {frames.map((f, i) => (
      <div class="flipbook-pix flipbook-frame" data-frame={i} hidden={i > 0} set:html={f.svg} />
    ))}
  </div>
  <ol class="strip" aria-label="The frames">
    {frames.map((f, i) => (
      <li class="strip-cell" data-cell={i} aria-current={i === 0 ? 'true' : undefined}>
        <div class="flipbook-pix" set:html={f.svg} />
        <span>{f.duration} ms</span>
      </li>
    ))}
  </ol>
  <button type="button" class="btn flipbook-toggle" data-toggle aria-pressed="false">
    Pause
  </button>
</div>

<script>
  for (const player of document.querySelectorAll<HTMLElement>('[data-flipbook]')) {
    const durations: number[] = JSON.parse(player.dataset.durations ?? '[]');
    const shown = [...player.querySelectorAll<HTMLElement>('[data-frame]')];
    const cells = [...player.querySelectorAll<HTMLElement>('[data-cell]')];
    const toggle = player.querySelector<HTMLButtonElement>('[data-toggle]')!;
    let frame = 0;
    let timer = 0;
    const show = (f: number) => {
      shown[frame].hidden = true;
      cells[frame].removeAttribute('aria-current');
      frame = f;
      shown[frame].hidden = false;
      cells[frame].setAttribute('aria-current', 'true');
    };
    const tick = () => {
      show((frame + 1) % durations.length);
      timer = window.setTimeout(tick, durations[frame]);
    };
    const set = (playing: boolean) => {
      clearTimeout(timer);
      if (playing) timer = window.setTimeout(tick, durations[frame]);
      toggle.textContent = playing ? 'Pause' : 'Play';
      toggle.setAttribute('aria-pressed', String(!playing));
    };
    toggle.addEventListener('click', () => set(toggle.textContent === 'Play'));
    set(!matchMedia('(prefers-reduced-motion: reduce)').matches);
  }
</script>

<style>
  .flipbook {
    display: grid;
    justify-items: center;
    gap: 16px;
    width: 100%;
  }
  .flipbook-stage {
    display: grid;
    width: 100%;
  }
  .flipbook-frame {
    grid-area: 1 / 1;
  }
  .flipbook-pix :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
  }
  .strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: 6px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .strip-cell {
    display: grid;
    gap: 4px;
    font-size: 11px;
    text-align: center;
    color: var(--tint-ink, var(--muted));
  }
  .strip-cell span {
    white-space: nowrap;
  }
  .strip-cell .flipbook-pix {
    outline: 2px solid transparent;
    outline-offset: 1px;
  }
  .strip-cell[aria-current] .flipbook-pix {
    outline-color: var(--accent);
  }
  .flipbook-toggle {
    min-width: 96px;
  }
  @media (max-width: 760px) {
    .strip {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }
    .strip-cell {
      font-size: 10px;
    }
  }
</style>
