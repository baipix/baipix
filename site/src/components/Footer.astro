---
/** Site footer, shared by every page. */
import { APP_URL, DESIGN_URL, LICENSE_URL, REPO_URL } from '../links';
import Logo from './Logo.astro';
import PixelIcon from './PixelIcon.astro';

const base = import.meta.env.BASE_URL;
/** BAIPIX in 5×7 letters, with the logo's pixel escaping past the X. */
const WORDMARK = [
  '....................................#',
  '####...###..#####.####..#####.#...#..',
  '#...#.#...#...#...#...#...#...#...#..',
  '#...#.#...#...#...#...#...#....#.#...',
  '####..#####...#...####....#.....#....',
  '#...#.#...#...#...#.......#....#.#...',
  '#...#.#...#...#...#.......#...#...#..',
  '####..#...#.#####.#.....#####.#...#..',
];

const COLUMNS: { title: string; links: [string, string][] }[] = [
  {
    title: 'Baipix',
    links: [
      [APP_URL, 'Open the editor'],
      [`${base}draw/`, 'Draw'],
      [`${base}#gallery`, 'Gallery'],
      [`${REPO_URL}/blob/main/CHANGELOG.md`, 'Changelog'],
    ],
  },
  {
    title: 'Guides',
    links: [
      [`${base}pixel-art-to-svg/`, 'Pixel art to SVG'],
      [`${base}pixel-art-for-figma/`, 'Pixel art for Figma'],
      [`${base}isometric-pixel-art/`, 'Isometric pixel art'],
    ],
  },
  {
    title: 'Project',
    links: [
      [REPO_URL, 'GitHub'],
      [DESIGN_URL, 'Design system'],
      [`${DESIGN_URL}#logo`, 'Logo'],
      [LICENSE_URL, 'MIT License'],
    ],
  },
];
---

<footer class="footer container">
  <div class="footer-about">
    <a class="brand" href={base}>
      <Logo size={14} />
      <span>Baipix</span>
    </a>
    <p class="muted">A free, open source pixel art editor, in your browser.</p>
    <p class="muted">© 2026 Baipix</p>
  </div>
  {/* The links in columns: the product, the guides, the project. */}
  <nav class="footer-columns" aria-label="Site">
    {COLUMNS.map((column) => (
      <div class="footer-column">
        <p class="footer-title">{column.title}</p>
        <ul>
          {column.links.map(([href, text]) => (
            <li>
              <a href={href}>{text}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
  <div class="wordmark" aria-hidden="true">
    <PixelIcon rows={WORDMARK} size={370} />
  </div>
</footer>

<style>
  .footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 40px;
    margin-top: 96px;
    padding: 40px 0;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .footer-about {
    display: grid;
    align-content: start;
    gap: 12px;
  }
  .footer-about p {
    margin: 0;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .footer-columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  /* The column titles in the site's pixel typeface, like the section labels. */
  .footer-title {
    margin: 0 0 14px;
    font:
      400 12px/1 'Silkscreen',
      var(--mono);
    color: var(--muted);
    text-transform: uppercase;
  }
  .footer-column ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-column a {
    color: var(--muted);
  }
  .footer-column a:hover {
    color: var(--text);
  }
  /* A big, faint BAIPIX across the bottom of the page. */
  .wordmark {
    grid-column: 1 / -1;
    margin-top: 16px;
    color: var(--line);
  }
  .wordmark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 720px) {
    .footer {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 480px) {
    .footer-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
