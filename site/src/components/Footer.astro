---
/** Site footer, shared by every page. */
import { DESIGN_URL, LICENSE_URL, REPO_URL } from '../links';
import Logo from './Logo.astro';
import PixelIcon from './PixelIcon.astro';

const base = import.meta.env.BASE_URL;
/** BAIPIX in 5×7 letters, with the logo's pixel escaping past the X. */
const WORDMARK = [
  '....................................#',
  '####...###..#####.####..#####.#...#..',
  '#...#.#...#...#...#...#...#...#...#..',
  '#...#.#...#...#...#...#...#....#.#...',
  '####..#####...#...####....#.....#....',
  '#...#.#...#...#...#.......#....#.#...',
  '#...#.#...#...#...#.......#...#...#..',
  '####..#...#.#####.#.....#####.#...#..',
];
---

<footer class="footer container">
  <a class="brand" href={base}>
    <Logo size={14} />
    <span>Baipix</span>
  </a>
  <nav class="footer-links">
    <a href={`${base}draw/`}>Draw</a>
    <a href={REPO_URL}>GitHub</a>
    <a href={DESIGN_URL}>Design system</a>
    <a href={`${DESIGN_URL}#logo`}>Logo</a>
    <a href={LICENSE_URL}>MIT License</a>
  </nav>
  <p class="muted">© 2026 Baipix</p>
  <div class="wordmark" aria-hidden="true">
    <PixelIcon rows={WORDMARK} size={370} />
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 96px;
    padding: 28px 0 40px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  /* A big, faint BAIPIX across the bottom of the page. */
  .wordmark {
    flex-basis: 100%;
    margin-top: 40px;
    color: var(--line);
  }
  .wordmark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .footer-links {
    display: flex;
    gap: 20px;
    margin-right: auto;
    color: var(--muted);
  }
  .footer-links a:hover {
    color: var(--text);
  }
</style>
