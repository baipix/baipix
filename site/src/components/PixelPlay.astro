---
/**
 * Plays a pixel animation from animations.ts on a canvas: it starts over each time it scrolls into
 * view, and pixels light up for a moment when they land. With reduced motion, a still picture.
 * Each run fires `pixelplay:start` on the canvas, for anything that plays along with it.
 */
import type { PixelAnimation } from '../animations';

interface Props {
  animation: PixelAnimation;
  label: string;
  class?: string;
}
const { animation, label, class: className } = Astro.props;

/**
 * The editor's tool icons (24×24, pixelarticons for the pencil and spray can, the bucket drawn on
 * the same grid), and the point of each that touches the canvas.
 */
const TOOLS = {
  pencil: {
    d: 'M4 16H6V18H8V20H10V22H2V14H4V16ZM12 20H10V18H12V20ZM14 18H12V16H14V18ZM10 16H8V14H10V16ZM16 16H14V14H16V16ZM6 14H4V12H6V14ZM12 14H10V12H12V14ZM18 14H16V12H18V14ZM8 12H6V10H8V12ZM14 12H12V10H14V12ZM20 12H18V10H20V12ZM10 10H8V8H10V10ZM18 10H16V8H18V10ZM22 10H20V8H22V10ZM12 8H10V6H12V8ZM16 8H14V6H16V8ZM20 8H18V6H20V8ZM14 6H12V4H14V6ZM18 6H16V4H18V6ZM16 4H14V2H16V4Z',
    hotspot: [3, 21],
  },
  bucket: {
    d: 'M8 2h2v2h-2zM6 4h2v2h-2zM10 4h2v2h-2zM4 6h2v2h-2zM12 6h2v2h-2zM2 8h2v2h-2zM14 8h2v2h-2zM0 10h18v2h-18zM20 10h2v2h-2zM2 12h14v2h-14zM18 12h6v2h-6zM4 14h10v2h-10zM18 14h6v2h-6zM6 16h6v2h-6zM20 16h2v2h-2zM8 18h2v2h-2z',
    hotspot: [21, 18],
  },
  gradient: {
    d: 'M0 0h2v2h-2zM2 0h2v2h-2zM4 0h2v2h-2zM6 0h2v2h-2zM8 0h2v2h-2zM10 0h2v2h-2zM12 0h2v2h-2zM14 0h2v2h-2zM16 0h2v2h-2zM18 0h2v2h-2zM20 0h2v2h-2zM22 0h2v2h-2zM0 2h2v2h-2zM2 2h2v2h-2zM4 2h2v2h-2zM6 2h2v2h-2zM8 2h2v2h-2zM12 2h2v2h-2zM16 2h2v2h-2zM22 2h2v2h-2zM0 4h2v2h-2zM2 4h2v2h-2zM4 4h2v2h-2zM6 4h2v2h-2zM8 4h2v2h-2zM10 4h2v2h-2zM14 4h2v2h-2zM22 4h2v2h-2zM0 6h2v2h-2zM2 6h2v2h-2zM4 6h2v2h-2zM6 6h2v2h-2zM8 6h2v2h-2zM12 6h2v2h-2zM16 6h2v2h-2zM22 6h2v2h-2zM0 8h2v2h-2zM2 8h2v2h-2zM4 8h2v2h-2zM6 8h2v2h-2zM8 8h2v2h-2zM10 8h2v2h-2zM14 8h2v2h-2zM22 8h2v2h-2zM0 10h2v2h-2zM2 10h2v2h-2zM4 10h2v2h-2zM6 10h2v2h-2zM8 10h2v2h-2zM12 10h2v2h-2zM16 10h2v2h-2zM22 10h2v2h-2zM0 12h2v2h-2zM2 12h2v2h-2zM4 12h2v2h-2zM6 12h2v2h-2zM8 12h2v2h-2zM10 12h2v2h-2zM14 12h2v2h-2zM22 12h2v2h-2zM0 14h2v2h-2zM2 14h2v2h-2zM4 14h2v2h-2zM6 14h2v2h-2zM8 14h2v2h-2zM12 14h2v2h-2zM16 14h2v2h-2zM22 14h2v2h-2zM0 16h2v2h-2zM2 16h2v2h-2zM4 16h2v2h-2zM6 16h2v2h-2zM8 16h2v2h-2zM10 16h2v2h-2zM14 16h2v2h-2zM22 16h2v2h-2zM0 18h2v2h-2zM2 18h2v2h-2zM4 18h2v2h-2zM6 18h2v2h-2zM8 18h2v2h-2zM12 18h2v2h-2zM16 18h2v2h-2zM22 18h2v2h-2zM0 20h2v2h-2zM2 20h2v2h-2zM4 20h2v2h-2zM6 20h2v2h-2zM8 20h2v2h-2zM10 20h2v2h-2zM14 20h2v2h-2zM22 20h2v2h-2zM0 22h2v2h-2zM2 22h2v2h-2zM4 22h2v2h-2zM6 22h2v2h-2zM8 22h2v2h-2zM10 22h2v2h-2zM12 22h2v2h-2zM14 22h2v2h-2zM16 22h2v2h-2zM18 22h2v2h-2zM20 22h2v2h-2zM22 22h2v2h-2z',
    hotspot: [1, 23],
  },
  spray: {
    d: 'M9 3h4v4H9zM7 7h8v2H7zM5 21h12v2H5zM15 9h2v12h-2zM5 9h2v12H5zm4 8h6v2H9zM9 13h2v6H9zM9 13h8v2H9zm6-10h2v2h-2zm2-2h2v2h-2zm0 4h2v2h-2z',
    hotspot: [21, 3],
  },
};
const tool = animation.tool && TOOLS[animation.tool];
const ICON = 22;
---

{tool ? (
  <div class="pixel-play-wrap">
    <canvas
      class:list={['pixel-play', className]}
      width={animation.w * 8}
      height={animation.h * 8}
      role="img"
      aria-label={label}
      data-pixel-play={JSON.stringify(animation)}
    />
    <svg
      class="tool-cursor"
      data-tool-cursor
      viewBox="0 0 24 24"
      width={ICON}
      height={ICON}
      style={`--hx: ${(tool.hotspot[0] * ICON) / 24}px; --hy: ${(tool.hotspot[1] * ICON) / 24}px`}
      aria-hidden="true"
    >
      <path fill="currentColor" d={tool.d} />
    </svg>
  </div>
) : (
  <canvas
    class:list={['pixel-play', className]}
    width={animation.w * 8}
    height={animation.h * 8}
    role="img"
    aria-label={label}
    data-pixel-play={JSON.stringify(animation)}
  />
)}

<script>
  import type { PixelAnimation } from '../animations';

  /** How long a pixel stays lit after landing, in ms. */
  const GLOW_MS = 700;
  /** How much of a canvas must be on screen for it to play. */
  const VISIBLE = 0.25;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  function player(canvas: HTMLCanvasElement) {
    const a: PixelAnimation = JSON.parse(canvas.dataset.pixelPlay!);
    const rgb = a.palette.map((hex) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16)));
    const end = (a.events.at(-4) ?? 0) + a.hold;
    const ctx = canvas.getContext('2d')!;
    const off = new OffscreenCanvas(a.w, a.h);
    const offCtx = off.getContext('2d')!;
    const image = new ImageData(a.w, a.h);
    // The tool's cursor, if the animation has one: it follows its points, in a straight line between.
    const toolCursor = canvas.parentElement?.querySelector<SVGElement>('[data-tool-cursor]') ?? null;
    const path = a.cursor ?? [];
    let point = 0;
    const moveCursor = (t: number) => {
      if (!toolCursor || !path.length) return;
      while (point + 3 < path.length && path[point + 3] <= t) point += 3;
      const shown = t >= path[0] && t <= path[path.length - 3] + 300;
      toolCursor.style.opacity = shown ? '1' : '0';
      if (!shown) return;
      let [, x, y] = path.slice(point, point + 3);
      if (point + 3 < path.length) {
        const [t0] = path.slice(point, point + 1);
        const [t1, x1, y1] = path.slice(point + 3, point + 6);
        const f = Math.min(1, Math.max(0, (t - t0) / (t1 - t0 || 1)));
        x += (x1 - x) * f;
        y += (y1 - y) * f;
      }
      toolCursor.style.left = `${(x / a.w) * 100}%`;
      toolCursor.style.top = `${(y / a.h) * 100}%`;
    };

    let next = 0; // index of the next event
    let lit: { x: number; y: number; t: number; color: string }[] = [];
    let origin = 0;
    let frame = 0;
    // Redraw only when a pixel changed or one is still lit: most frames have nothing new.
    let dirty = true;

    const put = (x: number, y: number, index: number) => {
      const o = (y * a.w + x) * 4;
      if (index) {
        const [r, g, b] = rgb[index - 1];
        image.data.set([r, g, b, 255], o);
      } else image.data.set([0, 0, 0, 0], o);
    };
    const reset = () => {
      a.start.forEach((index, i) => put(i % a.w, Math.floor(i / a.w), index));
      next = 0;
      lit = [];
      dirty = true;
      point = 0;
    };
    /** Plays every event up to `t`. */
    const advance = (t: number, glow: boolean) => {
      while (next < a.events.length && a.events[next] <= t) {
        const [time, x, y, index] = a.events.slice(next, next + 4);
        put(x, y, index);
        dirty = true;
        if (glow && index && a.glow) lit.push({ x, y, t: time, color: a.palette[index - 1] });
        next += 4;
      }
    };
    // Sharp pixels at any size: one canvas pixel per art pixel, scaled up without smoothing.
    const scale = () => Math.max(1, Math.round((canvas.clientWidth * devicePixelRatio) / a.w));

    const draw = (t: number) => {
      const k = scale();
      if (canvas.width !== a.w * k) {
        canvas.width = a.w * k;
        canvas.height = a.h * k;
      }
      offCtx.putImageData(image, 0, 0);
      ctx.imageSmoothingEnabled = false;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(off, 0, 0, canvas.width, canvas.height);
      lit = lit.filter((p) => t - p.t < GLOW_MS);
      if (!lit.length) return;
      /*
       * The light of a pixel that just landed, in pixels rather than a blur: the pixel itself
       * brightens, and its four neighbors light up faintly in a cross, then both fade. Plain
       * squares are cheap (a canvas shadow blur cost so much that the page stalled).
       */
      ctx.save();
      ctx.globalCompositeOperation = 'lighter';
      for (const p of lit) {
        const f = 1 - (t - p.t) / GLOW_MS;
        const x = p.x * k;
        const y = p.y * k;
        ctx.fillStyle = p.color;
        ctx.globalAlpha = f * f * a.glow;
        ctx.fillRect(x, y, k, k);
        ctx.globalAlpha = f * f * a.glow * 0.35;
        ctx.fillRect(x - k, y, k, k);
        ctx.fillRect(x + k, y, k, k);
        ctx.fillRect(x, y - k, k, k);
        ctx.fillRect(x, y + k, k, k);
      }
      ctx.restore();
    };
    const tick = (now: number) => {
      let t = now - origin;
      if (t > end) {
        origin = now;
        t = 0;
        reset();
        canvas.dispatchEvent(new Event('pixelplay:start'));
      }
      const wasLit = lit.length > 0;
      advance(t, true);
      moveCursor(t);
      // One more frame after the last glow fades, to clear it.
      if (dirty || wasLit || canvas.width !== a.w * scale()) draw(t);
      dirty = false;
      frame = requestAnimationFrame(tick);
    };

    const still = () => {
      cancelAnimationFrame(frame);
      reset();
      advance(a.still, false);
      draw(a.still);
      if (toolCursor) toolCursor.style.opacity = '0';
    };
    const play = () => {
      cancelAnimationFrame(frame);
      reset();
      origin = performance.now();
      frame = requestAnimationFrame(tick);
      canvas.dispatchEvent(new Event('pixelplay:start'));
    };

    still();
    // Plays once a quarter of it is on screen, stops when less: fewer canvases running at once.
    let playing = false;
    new IntersectionObserver(
      ([entry]) => {
        if (reduced.matches) return still();
        const visible = entry.intersectionRatio >= VISIBLE;
        if (visible && !playing) play();
        else if (!visible && playing) cancelAnimationFrame(frame);
        playing = visible;
      },
      { threshold: [0, VISIBLE] },
    ).observe(canvas);
  }

  document.querySelectorAll<HTMLCanvasElement>('[data-pixel-play]').forEach(player);
</script>

<style>
  .pixel-play-wrap {
    position: relative;
  }
  /* White with a dark edge, like the cursors elsewhere on the page, so it reads on any color. */
  .tool-cursor {
    position: absolute;
    left: 0;
    top: 0;
    margin: calc(-1 * var(--hy)) 0 0 calc(-1 * var(--hx));
    color: #ffffff;
    opacity: 0;
    filter: drop-shadow(1px 0 0 #000) drop-shadow(-1px 0 0 #000) drop-shadow(0 1px 0 #000)
      drop-shadow(0 -1px 0 #000);
    pointer-events: none;
  }
  .pixel-play {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
  }
</style>
