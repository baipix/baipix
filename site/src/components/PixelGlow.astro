---
/**
 * The hero's background, the same as the editor's files screen: a grid of small squares lit by
 * slow, crossing waves, a few of them twinkling in violet. Faint everywhere, fainter still around
 * the title. Still when the system asks for reduced motion.
 */
---

<canvas class="pixel-glow" aria-hidden="true"></canvas>

<script>
  /** The grid's step and the squares' side, in CSS pixels. */
  const CELL = 16;
  const SQUARE = 4;
  /** Frames per second: the light moves slowly, there's no need for more. */
  const FPS = 24;

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('.pixel-glow')) {
    const ctx = canvas.getContext('2d')!;
    // The colors come from the stylesheet, resolved for the current theme.
    let ink = '';
    let spark = '';
    const colors = () => {
      const style = getComputedStyle(canvas);
      ink = style.color;
      spark = style.outlineColor;
    };
    let cols = 0;
    let rows = 0;
    let dpr = 1;
    // Twinkles: a cell, when it lit up, and how long it lasts (seconds).
    let sparks: { i: number; at: number; life: number }[] = [];
    const still = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = true;

    const size = () => {
      dpr = window.devicePixelRatio || 1;
      const { width, height } = canvas.getBoundingClientRect();
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      cols = Math.ceil(width / CELL);
      rows = Math.ceil(height / CELL);
    };

    const draw = (t: number) => {
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const cx = cols / 2;
      const cy = rows * 0.35;
      const reach = Math.max(cols, rows) * 0.55;
      const off = (CELL - SQUARE) / 2;
      ctx.fillStyle = ink;
      for (let y = 0; y < rows; y++)
        for (let x = 0; x < cols; x++) {
          // Two slow waves crossing, and a broad swell: soft patches of light that drift.
          const wave =
            Math.sin(x * 0.11 + t * 0.31) * Math.sin(y * 0.15 - t * 0.23) +
            0.6 * Math.sin((x + y) * 0.045 - t * 0.17);
          const light = Math.max(0, wave) / 1.6;
          // Quieter around the title.
          const d = Math.hypot(x - cx, (y - cy) * 1.4) / reach;
          const room = Math.min(1, 0.3 + d * d);
          const a = (0.03 + light * 0.15) * room;
          if (a < 0.012) continue;
          ctx.globalAlpha = a;
          ctx.fillRect(x * CELL + off, y * CELL + off, SQUARE, SQUARE);
        }
      // The twinkles: rising and fading, with a soft glow.
      ctx.fillStyle = spark;
      ctx.shadowColor = spark;
      ctx.shadowBlur = 8;
      for (const p of sparks) {
        const k = (t - p.at) / p.life;
        if (k < 0 || k > 1) continue;
        ctx.globalAlpha = Math.sin(k * Math.PI) * 0.75;
        ctx.fillRect((p.i % cols) * CELL + off, Math.floor(p.i / cols) * CELL + off, SQUARE, SQUARE);
      }
      ctx.shadowBlur = 0;
      ctx.globalAlpha = 1;
    };

    let frame = 0;
    let last = 0;
    const tick = (now: number) => {
      frame = requestAnimationFrame(tick);
      if (now - last < 1000 / FPS) return;
      last = now;
      const t = now / 1000;
      // A new twinkle now and then, a dozen at most at once.
      sparks = sparks.filter((p) => t - p.at < p.life);
      if (sparks.length < 12 && Math.random() < 0.12)
        sparks.push({ i: Math.floor(Math.random() * cols * rows), at: t, life: 2 + Math.random() * 2.5 });
      draw(t);
    };
    // Runs only while on screen, and not at all with reduced motion.
    const start = () => {
      cancelAnimationFrame(frame);
      if (still.matches) draw(12);
      else if (visible) frame = requestAnimationFrame(tick);
    };

    // The theme can change while the page is open: the system's, or the one picked.
    const retheme = () => {
      colors();
      if (still.matches) draw(12);
    };
    new MutationObserver(retheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', retheme);
    still.addEventListener('change', start);
    new ResizeObserver(() => {
      size();
      if (still.matches) draw(12);
    }).observe(canvas);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      start();
    }).observe(canvas);
    colors();
    size();
    start();
  }
</script>

<style>
  .pixel-glow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    /* Read by the script: the squares' ink and the twinkles' violet, the editor's accent. */
    color: var(--text);
    outline: 0 none light-dark(#6e56cf, #9e8cfc);
    /* Fades out before the screenshot, so the grid has no edge. */
    mask-image: linear-gradient(#000 55%, transparent);
  }
</style>
