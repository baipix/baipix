---
/** Site header, shared by every page: links, GitHub stars, theme, and the way into the editor. */
import { APP_URL, REPO_URL } from '../links';
import Logo from './Logo.astro';
import PixelIcon from './PixelIcon.astro';
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL;
const STAR = ['...#...', '..###..', '#######', '.#####.', '..###..', '.##.##.', '.#...#.'];
const links = [
  { href: `${base}draw/`, label: 'Draw' },
  { href: `${base}pixel-art-animation/`, label: 'Animate' },
  { href: `${base}docs/`, label: 'Docs' },
  { href: `${base}#gallery`, label: 'Gallery' },
  { href: `${base}#install`, label: 'Get started' },
];
const here = Astro.url.pathname;
/** As wide as the docs, instead of the pages' column. */
const { wide = false } = Astro.props as { wide?: boolean };
---

<header class="site-header">
  <div class:list={['nav', wide ? 'container-wide' : 'container']}>
    <a class="brand" href={base} aria-label="Baipix home">
      <Logo size={18} />
      <span>Baipix</span>
    </a>
    <nav class="nav-links">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={
            here === l.href || (!l.href.includes('#') && here.startsWith(l.href)) ? 'page' : undefined
          }
        >
          {l.label}
        </a>
      ))}
    </nav>
    <a class="btn btn-small star" href={REPO_URL} aria-label="Star Baipix on GitHub">
      <PixelIcon rows={STAR} size={13} />
      <span class="star-label">Star</span>
      <span class="star-count" data-stars></span>
    </a>
    <ThemeToggle />
    <a class="btn btn-dark btn-small" href={APP_URL}>
      Open the editor
    </a>
  </div>
</header>

<script>
  // The header stays at the top; once the page has scrolled, a line sets it apart from what's under it.
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const edge = () => header.classList.toggle('is-scrolled', scrollY > 0);
  addEventListener('scroll', edge, { passive: true });
  edge();

  // Star count from the GitHub API; the button works without it.
  fetch('https://api.github.com/repos/baipix/baipix')
    .then((r) => (r.ok ? r.json() : null))
    .then((repo) => {
      const el = document.querySelector<HTMLElement>('[data-stars]');
      if (!el || typeof repo?.stargazers_count !== 'number') return;
      el.textContent = new Intl.NumberFormat('en', { notation: 'compact' }).format(repo.stargazers_count);
    })
    .catch(() => {});
</script>

<style>
  /* Stays at the top while the page scrolls, see-through enough to hint at what passes under it. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid transparent;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    transition: border-color 0.15s;
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--line);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
    height: var(--header-height);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .nav-links {
    display: flex;
    gap: 24px;
    margin-right: auto;
    font-size: 14px;
    color: var(--muted);
  }
  .nav-links a,
  .nav .btn {
    white-space: nowrap;
  }
  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--text);
  }
  /*
   * The count's room is kept from the start (3 characters: up to 999, then "1K"), so the button
   * doesn't grow when the number arrives from GitHub.
   */
  .star-count {
    /* 3 characters, plus the padding and the divider. */
    min-width: calc(3ch + 9px);
    text-align: right;
    padding-left: 8px;
    border-left: 1px solid var(--line);
    font: 500 13px/1 var(--mono);
    color: var(--muted);
  }
  /* Tighter, and the star keeps only its count. */
  @media (max-width: 1023px) {
    .nav {
      gap: 20px;
    }
    .nav-links {
      gap: 18px;
    }
    .star-label {
      display: none;
    }
  }
  /* The links on a row of their own under the brand and the buttons, scrolling sideways if need be. */
  @media (max-width: 860px) {
    .nav {
      flex-wrap: wrap;
      column-gap: 12px;
      row-gap: 0;
      height: var(--header-height);
    }
    .brand {
      height: 60px;
      margin-right: auto;
    }
    .nav-links {
      order: 1;
      width: 100%;
      height: 40px;
      align-items: center;
      margin: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
  }
  @media (max-width: 640px) {
    .star {
      display: none;
    }
  }
</style>
