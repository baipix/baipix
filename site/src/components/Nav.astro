---
/**
 * Site header, shared by every page: links, GitHub stars, and the way into the editor. On a phone the
 * links go in a menu behind a button. The theme switch is in the footer.
 */
import { posts } from '../blog';
import { APP_URL, REPO_URL } from '../links';
import Logo from './Logo.astro';
import PixelIcon from './PixelIcon.astro';

const base = import.meta.env.BASE_URL;
const STAR = ['...#...', '..###..', '#######', '.#####.', '..###..', '.##.##.', '.#...#.'];
const MENU = ['#######', '.......', '.......', '#######', '.......', '.......', '#######'];
const CLOSE = ['#.....#', '.#...#.', '..#.#..', '...#...', '..#.#..', '.#...#.', '#.....#'];
const links = [
  { href: `${base}draw/`, label: 'Draw' },
  { href: `${base}pixel-art-animation/`, label: 'Animate' },
  { href: `${base}docs/`, label: 'Docs' },
  { href: `${base}#gallery`, label: 'Gallery' },
  // Once there's a post to read.
  ...(posts.length ? [{ href: `${base}blog/`, label: 'Blog' }] : []),
];
// In the phone menu, under the links: the pages that are otherwise only in the footer.
const more = [
  { href: `${base}changelog/`, label: 'Release notes' },
  { href: `${base}roadmap/`, label: 'Roadmap' },
  { href: REPO_URL, label: 'GitHub' },
];
const here = Astro.url.pathname;
const current = (href: string) =>
  here === href || (!href.includes('#') && here.startsWith(href)) ? 'page' : undefined;
---

<header class="site-header">
  {/* As wide as the docs on every page, so it doesn't change size from a page to the docs. */}
  <div class="nav container-wide">
    <a class="brand" href={base} aria-label="Baipix home">
      <Logo size={24} />
      <span>Baipix</span>
    </a>
    <nav class="nav-links">
      {links.map((l) => (
        <a href={l.href} aria-current={current(l.href)}>
          {l.label}
        </a>
      ))}
    </nav>
    <a class="btn btn-small star" href={REPO_URL} aria-label="Star Baipix on GitHub">
      <PixelIcon rows={STAR} size={13} />
      <span class="star-label">Star</span>
      <span class="star-count" data-stars></span>
    </a>
    <a class="btn btn-dark btn-small editor" href={APP_URL}>
      <span class="editor-long">Open the editor</span>
      <span class="editor-short">Editor</span>
    </a>
    <button
      class="btn btn-small btn-icon menu-button"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-button
    >
      <span class="menu-open">
        <PixelIcon rows={MENU} size={14} />
      </span>
      <span class="menu-close">
        <PixelIcon rows={CLOSE} size={14} />
      </span>
    </button>
  </div>
  <nav id="site-menu" class="site-menu container-wide" aria-label="Menu" hidden data-menu>
    {links.map((l) => (
      <a href={l.href} aria-current={current(l.href)}>
        {l.label}
      </a>
    ))}
    <hr />
    {more.map((l) => (
      <a class="more" href={l.href} aria-current={current(l.href)}>
        {l.label}
      </a>
    ))}
  </nav>
</header>

<script>
  // The header stays at the top; once the page has scrolled, a line sets it apart from what's under it.
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const edge = () => header.classList.toggle('is-scrolled', scrollY > 0);
  addEventListener('scroll', edge, { passive: true });
  edge();

  // The phone menu: the button opens and closes it, and so do Escape, a link and a tap outside.
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;
  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Close the menu' : 'Menu');
  };
  button.addEventListener('click', () => setOpen(menu.hidden));
  menu.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setOpen(false);
  });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      setOpen(false);
      button.focus();
    }
  });
  addEventListener('click', (e) => {
    if (!menu.hidden && !header.contains(e.target as Node)) setOpen(false);
  });
  // Back to a wide screen: the links are in the bar again.
  matchMedia('(min-width: 861px)').addEventListener('change', (e) => e.matches && setOpen(false));

  // Star count from the GitHub API; the button works without it.
  fetch('https://api.github.com/repos/baipix/baipix')
    .then((r) => (r.ok ? r.json() : null))
    .then((repo) => {
      const el = document.querySelector<HTMLElement>('[data-stars]');
      if (!el || typeof repo?.stargazers_count !== 'number') return;
      el.textContent = new Intl.NumberFormat('en', { notation: 'compact' }).format(repo.stargazers_count);
    })
    .catch(() => {});
</script>

<style>
  /* Stays at the top while the page scrolls, see-through enough to hint at what passes under it. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid transparent;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    transition: border-color 0.15s;
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--line);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
    height: var(--header-height);
  }
  /* Like Linear's: the brand alone on the left, the links on the right, then a line and the buttons. */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-right: auto;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-right: 32px;
    border-right: 1px solid var(--line);
    font-size: 15px;
    color: var(--muted);
  }
  .nav-links a,
  .nav .btn {
    white-space: nowrap;
  }
  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--text);
  }
  /*
   * The count's room is kept from the start (3 characters: up to 999, then "1K"), so the button
   * doesn't grow when the number arrives from GitHub.
   */
  .star-count {
    /* 3 characters, plus the padding and the divider. */
    min-width: calc(3ch + 9px);
    text-align: right;
    padding-left: 8px;
    border-left: 1px solid var(--line);
    font: 500 13px/1 var(--mono);
    color: var(--muted);
  }
  /* Tighter, and the star keeps only its count. */
  @media (max-width: 1023px) {
    .nav {
      gap: 20px;
    }
    .nav-links {
      gap: 18px;
      padding-right: 20px;
    }
    .star-label {
      display: none;
    }
  }
  /* The menu button and the short label only show on a phone. */
  .menu-button,
  .editor-short,
  .site-menu {
    display: none;
  }
  .menu-button span {
    display: flex;
  }
  .menu-button[aria-expanded='true'] .menu-open,
  .menu-button[aria-expanded='false'] .menu-close {
    display: none;
  }
  /* On a phone: the brand, the stars, the editor and a menu button on one row; the links in the menu. */
  @media (max-width: 860px) {
    .nav {
      gap: 8px;
    }
    .nav-links,
    .editor-long {
      display: none;
    }
    .editor-short {
      display: inline;
    }
    .menu-button {
      display: inline-flex;
    }
    .site-menu:not([hidden]) {
      display: grid;
      padding-top: 8px;
      padding-bottom: 20px;
      border-top: 1px solid var(--line);
    }
    .site-menu a {
      padding: 12px 0;
      font-size: 18px;
      font-weight: 500;
    }
    .site-menu a.more {
      padding: 8px 0;
      font-size: 15px;
      font-weight: 400;
      color: var(--muted);
    }
    .site-menu a[aria-current='page'] {
      color: var(--accent, var(--text));
    }
    .site-menu hr {
      width: 100%;
      margin: 8px 0;
      border: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
