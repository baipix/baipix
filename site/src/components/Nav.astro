---
/** Site header, shared by every page: links, GitHub stars, theme, and the way into the editor. */
import { APP_URL, REPO_URL } from '../links';
import Logo from './Logo.astro';
import PixelIcon from './PixelIcon.astro';
import ThemeToggle from './ThemeToggle.astro';

const base = import.meta.env.BASE_URL;
const STAR = ['...#...', '..###..', '#######', '.#####.', '..###..', '.##.##.', '.#...#.'];
const links = [
  { href: `${base}draw/`, label: 'Draw' },
  { href: `${base}#gallery`, label: 'Gallery' },
  { href: `${base}#install`, label: 'Get started' },
];
const here = Astro.url.pathname;
---

<header class="nav container">
  <a class="brand" href={base} aria-label="Baipix home">
    <Logo size={18} />
    <span>Baipix</span>
  </a>
  <nav class="nav-links">
    {links.map((l) => (
      <a href={l.href} aria-current={here === l.href ? 'page' : undefined}>
        {l.label}
      </a>
    ))}
  </nav>
  <a class="btn btn-small star" href={REPO_URL} aria-label="Star Baipix on GitHub">
    <PixelIcon rows={STAR} size={13} />
    <span>Star</span>
    <span class="star-count" data-stars></span>
  </a>
  <ThemeToggle />
  <a class="btn btn-dark btn-small" href={APP_URL}>
    Open the editor
  </a>
</header>

<script>
  // Star count from the GitHub API; the button works without it.
  fetch('https://api.github.com/repos/baipix/baipix')
    .then((r) => (r.ok ? r.json() : null))
    .then((repo) => {
      const el = document.querySelector<HTMLElement>('[data-stars]');
      if (!el || typeof repo?.stargazers_count !== 'number') return;
      el.textContent = new Intl.NumberFormat('en', { notation: 'compact' }).format(repo.stargazers_count);
    })
    .catch(() => {});
</script>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .nav-links {
    display: flex;
    gap: 24px;
    margin-right: auto;
    font-size: 14px;
    color: var(--muted);
  }
  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--text);
  }
  /*
   * The count's room is kept from the start (3 characters: up to 999, then "1K"), so the button
   * doesn't grow when the number arrives from GitHub.
   */
  .star-count {
    /* 3 characters, plus the padding and the divider. */
    min-width: calc(3ch + 9px);
    text-align: right;
    padding-left: 8px;
    border-left: 1px solid var(--line);
    font: 500 13px/1 var(--mono);
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .nav-links,
    .star {
      display: none;
    }
    .nav {
      justify-content: space-between;
      gap: 12px;
    }
    .nav :global(.theme-toggle) {
      margin-left: auto;
    }
  }
</style>
