---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Kept out of search results (the 404 page). */
  noindex?: boolean;
  /** Structured data for search engines (schema.org), as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}
const { title, description, noindex = false, jsonLd } = Astro.props;
const base = import.meta.env.BASE_URL;
// The page's one address for search engines, and the image shown when the link is shared.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL(`${base}og.png`, Astro.site).href;
const analytics = import.meta.env.PROD;
const favicon =
  "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8' shape-rendering='crispEdges'><style>path{fill:%23000}@media (prefers-color-scheme:dark){path{fill:%23fff}}</style><path d='M0 2h3v6H0zM3 5h3v3H3zM5 0h3v3H5z'/></svg>";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Baipix" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Baipix pixel art editor" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={shareImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="sitemap" href={`${base}sitemap.xml`} />
    <link rel="icon" href={favicon} />
    {
      /* Cloudflare Web Analytics: page views only, no cookies. */
      analytics && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon='{"token": "c751710cc6a54b69a0442aec83131356"}'
        ></script>
      )
    }
    <script is:inline>
      // Theme before the first paint: the visitor's choice (ThemeToggle), otherwise the OS setting.
      (() => {
        const media = matchMedia('(prefers-color-scheme: dark)');
        const apply = () => {
          let stored = null;
          try {
            stored = localStorage.getItem('baipix-site-theme');
          } catch {}
          const theme = stored === 'light' || stored === 'dark' ? stored : media.matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = theme;
        };
        apply();
        media.addEventListener('change', apply);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&family=Silkscreen&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
