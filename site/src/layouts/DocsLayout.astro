---
/**
 * A docs page: the site's header, the table of contents on the left (it stays in view), the page
 * itself, then the previous and next pages. Markdown pages use it through their `layout`, .astro
 * pages wrap their content in it.
 */
import ArrowIcon from '../components/ArrowIcon.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import PixelIcon from '../components/PixelIcon.astro';
import { DOC_PAGES, DOCS } from '../docs';
import Base from './Base.astro';

interface Props {
  title?: string;
  description?: string;
  /** Set by Markdown pages: their frontmatter. */
  frontmatter?: { title: string; description: string };
}
const props = Astro.props;
const title = props.frontmatter?.title ?? props.title ?? 'Docs';
const description = props.frontmatter?.description ?? props.description ?? '';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = (slug: string) => `${base}docs/${slug}/`;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const index = DOC_PAGES.findIndex((p) => href(p.slug) === path);
const prev = index > 0 ? DOC_PAGES[index - 1] : null;
const next = index >= 0 && index < DOC_PAGES.length - 1 ? DOC_PAGES[index + 1] : null;
/** The pixel arrow of the site's buttons, turned to point back. */
const LEFT = ['...#...', '..#....', '.#.....', '#######', '.#.....', '..#....', '...#...'];
const section = DOCS.find((s) => s.pages.some((p) => href(p.slug) === path));
---

<Base title={`${title} · Baipix docs`} description={description}>
  <Nav wide />
  <div class="docs container-wide">
    <nav class="docs-nav" aria-label="Docs">
      <a class="docs-home" href={`${base}docs/`} aria-current={path === `${base}docs/` ? 'page' : undefined}>
        Docs
      </a>
      {DOCS.map((s) => (
        <div class="docs-group">
          <p class="docs-group-title">{s.title}</p>
          <ul>
            {s.pages.map((p) => (
              <li>
                <a href={href(p.slug)} aria-current={href(p.slug) === path ? 'page' : undefined}>
                  {p.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
    <main class="docs-main">
      {section && <p class="docs-eyebrow">{section.title}</p>}
      <article class="docs-content">
        <h1>{title}</h1>
        <slot />
      </article>
      {(prev || next) && (
        <nav class="docs-pager" aria-label="Previous and next pages">
          {prev ? (
            <div class="pager-side">
              <span class="pager-label">Previous</span>
              <a class="btn" href={href(prev.slug)}>
                <span class="pager-arrow" aria-hidden="true">
                  <PixelIcon rows={LEFT} size={12} />
                </span>
                {prev.title}
              </a>
            </div>
          ) : (
            <span />
          )}
          {next && (
            <div class="pager-side next">
              <span class="pager-label">Next</span>
              <a class="btn" href={href(next.slug)}>
                {next.title}
                <ArrowIcon />
              </a>
            </div>
          )}
        </nav>
      )}
    </main>
    {/* Filled in the browser from the page's headings, the one you're reading lit. */}
    <aside class="docs-toc" aria-label="On this page" hidden>
      <p class="docs-toc-title">On this page</p>
      <ul></ul>
    </aside>
  </div>
  <Footer wide />
</Base>

<script>
  // The page's sections in the right column: each h2, linked by an id made from its text if it
  // has none, and the one at the top of the screen highlighted as you scroll.
  const toc = document.querySelector<HTMLElement>('.docs-toc');
  const headings = [...document.querySelectorAll<HTMLHeadingElement>('.docs-content h2')];
  if (toc && headings.length > 1) {
    const list = toc.querySelector('ul')!;
    const slug = (text: string) =>
      text
        .toLowerCase()
        .normalize('NFD')
        .replace(/[^a-z0-9\s-]/g, '')
        .trim()
        .replace(/\s+/g, '-');
    const links = headings.map((h) => {
      h.id ||= slug(h.textContent ?? '');
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${h.id}`;
      a.textContent = h.textContent;
      li.append(a);
      list.append(li);
      return a;
    });
    toc.hidden = false;
    let current: HTMLAnchorElement | null = null;
    const update = () => {
      // The last heading above a line just under the sticky header.
      const line =
        parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) + 40;
      let at = 0;
      headings.forEach((h, i) => {
        if (h.getBoundingClientRect().top <= line) at = i;
      });
      if (links[at] === current) return;
      current?.removeAttribute('aria-current');
      current = links[at];
      current.setAttribute('aria-current', 'location');
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  .docs {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 56px;
    padding-top: 48px;
  }
  /* With room for it, a third column: the page's own sections. */
  @media (min-width: 1200px) {
    .docs {
      grid-template-columns: 240px minmax(0, 1fr) 220px;
    }
  }
  .docs-toc {
    position: sticky;
    top: calc(var(--header-height) + 24px);
    align-self: start;
    max-height: calc(100vh - var(--header-height) - 48px);
    overflow-y: auto;
    font-size: 13px;
  }
  .docs-toc-title {
    margin: 0 0 12px;
    font:
      400 12px/1 'Silkscreen',
      var(--mono);
    color: var(--muted);
    text-transform: uppercase;
  }
  .docs-toc ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .docs-toc :global(a) {
    display: block;
    padding: 4px 0 4px 10px;
    border-left: 1px solid var(--line);
    color: var(--muted);
  }
  .docs-toc :global(a:hover) {
    color: var(--text);
  }
  .docs-toc :global(a[aria-current]) {
    border-left-color: var(--text);
    color: var(--text);
  }
  @media (max-width: 1199px) {
    .docs-toc {
      display: none;
    }
  }
  /* The table of contents stays in view under the sticky header. */
  .docs-nav {
    position: sticky;
    top: calc(var(--header-height) + 24px);
    align-self: start;
    max-height: calc(100vh - var(--header-height) - 48px);
    overflow-y: auto;
    padding-right: 24px;
    border-right: 1px solid var(--line);
    font-size: 14px;
  }
  .docs-home {
    display: block;
    margin-bottom: 20px;
    font-weight: 600;
  }
  .docs-group + .docs-group {
    margin-top: 24px;
  }
  .docs-group-title {
    margin: 0 0 10px;
    font:
      400 12px/1 'Silkscreen',
      var(--mono);
    color: var(--muted);
    text-transform: uppercase;
  }
  .docs-group ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .docs-nav a {
    display: block;
    padding: 5px 10px;
    margin-left: -10px;
    border-left: 2px solid transparent;
    color: var(--muted);
  }
  .docs-nav a:hover {
    color: var(--text);
  }
  .docs-nav a[aria-current='page'] {
    border-left-color: var(--accent, var(--text));
    color: var(--text);
    font-weight: 500;
  }
  /* The text at a comfortable measure, centered between the two columns. */
  .docs-main {
    justify-self: center;
    width: 100%;
    min-width: 0;
    max-width: 800px;
  }
  .docs-eyebrow {
    margin: 0 0 12px;
    font:
      400 14px/1 'Silkscreen',
      var(--mono);
    color: var(--muted);
    text-transform: uppercase;
  }

  /* ---- The page's text, written in Markdown ---- */
  .docs-content :global(h1) {
    margin: 0 0 20px;
    font-size: clamp(32px, 4.4vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .docs-content :global(h2) {
    margin: 48px 0 12px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 24px;
    letter-spacing: -0.02em;
  }
  .docs-content :global(h3) {
    margin: 28px 0 8px;
    font-size: 18px;
  }
  .docs-content :global(p),
  .docs-content :global(li) {
    color: var(--muted);
    line-height: 1.7;
  }
  .docs-content :global(p) {
    margin: 0 0 14px;
  }
  .docs-content :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .docs-content :global(ul),
  .docs-content :global(ol) {
    margin: 0 0 16px;
    padding-left: 22px;
  }
  .docs-content :global(li + li) {
    margin-top: 6px;
  }
  .docs-content :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .docs-content :global(code),
  .docs-content :global(kbd) {
    padding: 2px 6px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text);
    font: 500 13px/1.4 var(--mono);
  }
  .docs-content :global(kbd) {
    border-color: var(--line-strong);
    box-shadow: 0 2px 0 var(--line-strong);
  }
  .docs-content :global(table) {
    width: 100%;
    margin: 8px 0 20px;
    border-collapse: collapse;
    font-size: 15px;
  }
  .docs-content :global(th),
  .docs-content :global(td) {
    padding: 10px 12px 10px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .docs-content :global(th) {
    color: var(--text);
    font-weight: 600;
  }
  .docs-content :global(td) {
    color: var(--muted);
  }
  .docs-content :global(blockquote) {
    margin: 0 0 16px;
    padding: 12px 16px;
    border-left: 2px solid var(--accent, var(--line-strong));
    background: var(--surface);
  }
  .docs-content :global(blockquote p) {
    margin: 0;
  }

  /* ---- Screenshots: one per theme, the one matching the site's shows ---- */
  .docs-content :global(.shot) {
    margin: 12px 0 28px;
  }
  .docs-content :global(.shot img) {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }
  .docs-content :global(.shot figcaption) {
    margin-top: 10px;
    font-size: 14px;
    color: var(--muted);
  }
  .docs-content :global(.shot .for-dark) {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .docs-content :global(.shot .for-light) {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .docs-content :global(.shot .for-dark) {
      display: block;
    }
  }
  :global(:root[data-theme='dark']) .docs-content :global(.shot .for-light) {
    display: none;
  }
  :global(:root[data-theme='dark']) .docs-content :global(.shot .for-dark) {
    display: block;
  }

  /* ---- Previous and next: the site's pixel buttons, the page's name on them ---- */
  .docs-pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .pager-side {
    display: grid;
    justify-items: start;
    gap: 10px;
  }
  .pager-side.next {
    justify-items: end;
    margin-left: auto;
  }
  .pager-label {
    font:
      400 12px/1 'Silkscreen',
      var(--mono);
    color: var(--muted);
    text-transform: uppercase;
  }
  .pager-arrow {
    display: inline-flex;
  }

  @media (max-width: 860px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 24px;
    }
    /* On a phone the table of contents comes first, as a plain list. */
    .docs-nav {
      position: static;
      max-height: none;
      padding: 0 0 20px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
