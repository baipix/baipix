---
/**
 * A docs page: the site's header, the table of contents on the left (it stays in view), the page
 * itself, then the previous and next pages. Markdown pages use it through their `layout`, .astro
 * pages wrap their content in it.
 */
import ArrowIcon from '../components/ArrowIcon.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import PixelIcon from '../components/PixelIcon.astro';
import { DOC_PAGES, DOCS } from '../docs';
import Base from './Base.astro';

interface Props {
  title?: string;
  description?: string;
  /** Set by Markdown pages: their frontmatter. */
  frontmatter?: { title: string; description: string };
}
const props = Astro.props;
const title = props.frontmatter?.title ?? props.title ?? 'Docs';
const description = props.frontmatter?.description ?? props.description ?? '';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const href = (slug: string) => `${base}docs/${slug}/`;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const index = DOC_PAGES.findIndex((p) => href(p.slug) === path);
const prev = index > 0 ? DOC_PAGES[index - 1] : null;
const next = index >= 0 && index < DOC_PAGES.length - 1 ? DOC_PAGES[index + 1] : null;
/** The pixel arrow of the site's buttons, turned to point back. */
const LEFT = ['...#...', '..#....', '.#.....', '#######', '.#.....', '..#....', '...#...'];
const section = DOCS.find((s) => s.pages.some((p) => href(p.slug) === path));
---

<Base title={`${title} · Baipix docs`} description={description}>
  <Nav wide />
  <div class="docs container-wide">
    <div class="docs-side">
      {/* Search: the index loads on first use, results show over the table of contents. */}
      <div class="docs-search" role="search">
        <input
          type="search"
          placeholder="Search the docs"
          aria-label="Search the docs"
          aria-controls="docs-results"
          autocomplete="off"
          spellcheck="false"
          data-index={`${base}docs/search.json`}
        />
        <kbd class="docs-search-key" aria-hidden="true">
          /
        </kbd>
        <ul id="docs-results" class="docs-results" hidden></ul>
      </div>
      <nav class="docs-nav" aria-label="Docs">
        <a
          class="docs-home"
          href={`${base}docs/`}
          aria-current={path === `${base}docs/` ? 'page' : undefined}
        >
          Docs
        </a>
        {DOCS.map((s) => (
          <div class="docs-group">
            <p class="docs-group-title">{s.title}</p>
            <ul>
              {s.pages.map((p) => (
                <li>
                  <a href={href(p.slug)} aria-current={href(p.slug) === path ? 'page' : undefined}>
                    {p.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <main class="docs-main">
      {section && <p class="docs-eyebrow">{section.title}</p>}
      <article class="docs-content">
        <h1>{title}</h1>
        <slot />
      </article>
      {(prev || next) && (
        <nav class="docs-pager" aria-label="Previous and next pages">
          {prev ? (
            <div class="pager-side">
              <span class="pager-label">Previous</span>
              <a class="btn" href={href(prev.slug)}>
                <span class="pager-arrow" aria-hidden="true">
                  <PixelIcon rows={LEFT} size={12} />
                </span>
                {prev.title}
              </a>
            </div>
          ) : (
            <span />
          )}
          {next && (
            <div class="pager-side next">
              <span class="pager-label">Next</span>
              <a class="btn" href={href(next.slug)}>
                {next.title}
                <ArrowIcon />
              </a>
            </div>
          )}
        </nav>
      )}
    </main>
    {/* Filled in the browser from the page's headings, the one you're reading lit. */}
    <aside class="docs-toc" aria-label="On this page" hidden>
      <p class="docs-toc-title">On this page</p>
      <ul></ul>
    </aside>
  </div>
  <Footer wide />
</Base>

<script>
  // Search the docs: every word typed must appear in a section's page name, title or text; the
  // title counts most. The best ten show, each with a bit of text around the first word found.
  interface Entry {
    url: string;
    page: string;
    title: string;
    text: string;
  }
  const box = document.querySelector<HTMLDivElement>('.docs-search');
  if (box) {
    const input = box.querySelector('input')!;
    const list = box.querySelector<HTMLUListElement>('.docs-results')!;
    let index: Entry[] | null = null;
    let loading: Promise<void> | null = null;
    const load = () =>
      (loading ??= fetch(input.dataset.index!)
        .then((r) => r.json())
        .then((entries: Entry[]) => {
          index = entries;
        })
        .catch(() => {
          index = [];
        }));
    const fold = (t: string) =>
      t
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');
    const snippet = (text: string, word: string) => {
      const at = fold(text).indexOf(word);
      if (at < 0) return text.slice(0, 110) + (text.length > 110 ? '…' : '');
      const start = Math.max(0, at - 40);
      return (start ? '…' : '') + text.slice(start, start + 120) + (start + 120 < text.length ? '…' : '');
    };
    let active = -1;
    const items = () => [...list.querySelectorAll<HTMLAnchorElement>('a')];
    const show = () => {
      const words = fold(input.value).split(/\s+/).filter(Boolean);
      list.replaceChildren();
      active = -1;
      if (!words.length || !index) {
        list.hidden = true;
        return;
      }
      const scored = index
        .map((e) => {
          const title = fold(e.title);
          const page = fold(e.page);
          const text = fold(e.text);
          let score = 0;
          for (const w of words) {
            if (title.includes(w)) score += 10;
            else if (page.includes(w)) score += 4;
            else if (text.includes(w)) score += 1;
            else return null;
          }
          return { e, score };
        })
        .filter((x): x is { e: Entry; score: number } => !!x)
        .sort((a, b) => b.score - a.score)
        .slice(0, 10);
      if (!scored.length) {
        const li = document.createElement('li');
        li.className = 'docs-results-empty';
        li.textContent = 'Nothing found.';
        list.append(li);
      }
      for (const { e } of scored) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = e.url;
        const title = document.createElement('strong');
        title.textContent = e.title === e.page ? e.page : `${e.title}`;
        const where = document.createElement('span');
        where.className = 'docs-results-page';
        where.textContent = e.title === e.page ? '' : e.page;
        const text = document.createElement('span');
        text.className = 'docs-results-text';
        text.textContent = snippet(e.text, words[0]);
        a.append(title, where, text);
        li.append(a);
        list.append(li);
      }
      list.hidden = false;
    };
    input.addEventListener('focus', () => void load());
    input.addEventListener('input', async () => {
      await load();
      show();
    });
    input.addEventListener('keydown', (e) => {
      const links = items();
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        if (!links.length) return;
        e.preventDefault();
        active = (active + (e.key === 'ArrowDown' ? 1 : -1) + links.length) % links.length;
        links.forEach((l, i) => l.toggleAttribute('aria-selected', i === active));
      } else if (e.key === 'Enter') {
        const link = links[Math.max(0, active)];
        if (link) location.href = link.href;
      } else if (e.key === 'Escape') {
        input.value = '';
        show();
        input.blur();
      }
    });
    // A click elsewhere closes the results.
    document.addEventListener('click', (e) => {
      if (!box.contains(e.target as Node)) list.hidden = true;
    });
    input.addEventListener('focus', () => {
      if (input.value) show();
    });
    // "/" anywhere on the page goes to the search box.
    document.addEventListener('keydown', (e) => {
      const typing = e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement;
      if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey) {
        e.preventDefault();
        input.focus();
      }
    });
  }

  // The page's sections in the right column: each h2, linked by an id made from its text if it
  // has none, and the one at the top of the screen highlighted as you scroll.
  const toc = document.querySelector<HTMLElement>('.docs-toc');
  const headings = [...document.querySelectorAll<HTMLHeadingElement>('.docs-content h2')];
  if (toc && headings.length > 1) {
    const list = toc.querySelector('ul')!;
    const slug = (text: string) =>
      text
        .toLowerCase()
        .normalize('NFD')
        .replace(/[^a-z0-9\s-]/g, '')
        .trim()
        .replace(/\s+/g, '-');
    const links = headings.map((h) => {
      h.id ||= slug(h.textContent ?? '');
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${h.id}`;
      a.textContent = h.textContent;
      li.append(a);
      list.append(li);
      return a;
    });
    toc.hidden = false;
    let current: HTMLAnchorElement | null = null;
    const update = () => {
      // The last heading above a line just under the sticky header.
      const line =
        parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) + 40;
      let at = 0;
      headings.forEach((h, i) => {
        if (h.getBoundingClientRect().top <= line) at = i;
      });
      if (links[at] === current) return;
      current?.removeAttribute('aria-current');
      current = links[at];
      current.setAttribute('aria-current', 'location');
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  .docs {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 56px;
    padding-top: 48px;
  }
  /* With room for it, a third column: the page's own sections. */
  @media (min-width: 1200px) {
    .docs {
      grid-template-columns: 240px minmax(0, 1fr) 220px;
    }
  }
  .docs-toc {
    position: sticky;
    top: calc(var(--header-height) + 24px);
    align-self: start;
    max-height: calc(100vh - var(--header-height) - 48px);
    overflow-y: auto;
    font-size: 13px;
  }
  .docs-toc-title {
    margin: 0 0 12px;
    font:
      400 12px/1 'Silkscreen',
      var(--mono);
    color: var(--muted);
    text-transform: uppercase;
  }
  .docs-toc ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .docs-toc :global(a) {
    display: block;
    padding: 4px 0 4px 10px;
    border-left: 1px solid var(--line);
    color: var(--muted);
  }
  .docs-toc :global(a:hover) {
    color: var(--text);
  }
  .docs-toc :global(a[aria-current]) {
    border-left-color: var(--text);
    color: var(--text);
  }
  @media (max-width: 1199px) {
    .docs-toc {
      display: none;
    }
  }
  /* The search and the table of contents stay in view under the sticky header; only the table of
     contents scrolls, so the search results can spread over the page. */
  .docs-side {
    position: sticky;
    top: calc(var(--header-height) + 24px);
    align-self: start;
    padding-right: 24px;
    border-right: 1px solid var(--line);
  }
  .docs-nav {
    max-height: calc(100vh - var(--header-height) - 108px);
    overflow-y: auto;
    font-size: 14px;
  }
  /* ---- Search ---- */
  .docs-search {
    position: relative;
    margin-bottom: 24px;
  }
  .docs-search input {
    width: 100%;
    height: 36px;
    padding: 0 32px 0 12px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 14px;
  }
  /* Escape clears it: no native clear button over the "/" key. */
  .docs-search input::-webkit-search-cancel-button {
    display: none;
  }
  .docs-search input:focus {
    outline: 2px solid var(--accent, var(--text));
    outline-offset: -1px;
  }
  .docs-search-key {
    position: absolute;
    top: 9px;
    right: 10px;
    padding: 0 5px;
    border: 1px solid var(--line);
    color: var(--muted);
    font: 500 11px/16px var(--mono);
    pointer-events: none;
  }
  .docs-results {
    position: absolute;
    z-index: 25;
    top: 42px;
    left: 0;
    width: min(420px, calc(100vw - 32px));
    max-height: 60vh;
    margin: 0;
    padding: 6px 0;
    overflow-y: auto;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.25);
    list-style: none;
  }
  .docs-results :global(a) {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 10px 14px;
    border: 0;
    color: var(--text);
  }
  .docs-results :global(a:hover),
  .docs-results :global(a[aria-selected]) {
    background: var(--surface);
  }
  .docs-results :global(strong) {
    font-weight: 600;
  }
  .docs-results :global(.docs-results-page) {
    font-size: 12px;
    color: var(--muted);
  }
  .docs-results :global(.docs-results-page:empty) {
    display: none;
  }
  .docs-results :global(.docs-results-text) {
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }
  .docs-results :global(.docs-results-empty) {
    padding: 10px 14px;
    font-size: 14px;
    color: var(--muted);
  }
  .docs-home {
    display: block;
    margin-bottom: 20px;
    font-weight: 600;
  }
  .docs-group + .docs-group {
    margin-top: 24px;
  }
  .docs-group-title {
    margin: 0 0 10px;
    font:
      400 12px/1 'Silkscreen',
      var(--mono);
    color: var(--muted);
    text-transform: uppercase;
  }
  .docs-group ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .docs-nav a {
    display: block;
    padding: 5px 10px;
    margin-left: -10px;
    border-left: 2px solid transparent;
    color: var(--muted);
  }
  .docs-nav a:hover {
    color: var(--text);
  }
  .docs-nav a[aria-current='page'] {
    border-left-color: var(--accent, var(--text));
    color: var(--text);
    font-weight: 500;
  }
  /* The text at a comfortable measure, centered between the two columns. */
  .docs-main {
    justify-self: center;
    width: 100%;
    min-width: 0;
    max-width: 800px;
  }
  .docs-eyebrow {
    margin: 0 0 12px;
    font:
      400 14px/1 'Silkscreen',
      var(--mono);
    color: var(--muted);
    text-transform: uppercase;
  }

  /* ---- The page's text, written in Markdown ---- */
  .docs-content :global(h1) {
    margin: 0 0 20px;
    font-size: clamp(32px, 4.4vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .docs-content :global(h2) {
    margin: 48px 0 12px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 24px;
    letter-spacing: -0.02em;
  }
  .docs-content :global(h3) {
    margin: 28px 0 8px;
    font-size: 18px;
  }
  .docs-content :global(p),
  .docs-content :global(li) {
    color: var(--muted);
    line-height: 1.7;
  }
  .docs-content :global(p) {
    margin: 0 0 14px;
  }
  .docs-content :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .docs-content :global(ul),
  .docs-content :global(ol) {
    margin: 0 0 16px;
    padding-left: 22px;
  }
  .docs-content :global(li + li) {
    margin-top: 6px;
  }
  .docs-content :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .docs-content :global(code),
  .docs-content :global(kbd) {
    padding: 2px 6px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text);
    font: 500 13px/1.4 var(--mono);
  }
  .docs-content :global(kbd) {
    border-color: var(--line-strong);
    box-shadow: 0 2px 0 var(--line-strong);
  }
  .docs-content :global(table) {
    width: 100%;
    margin: 8px 0 20px;
    border-collapse: collapse;
    font-size: 15px;
  }
  .docs-content :global(th),
  .docs-content :global(td) {
    padding: 10px 12px 10px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .docs-content :global(th) {
    color: var(--text);
    font-weight: 600;
  }
  .docs-content :global(td) {
    color: var(--muted);
  }
  .docs-content :global(blockquote) {
    margin: 0 0 16px;
    padding: 12px 16px;
    border-left: 2px solid var(--accent, var(--line-strong));
    background: var(--surface);
  }
  .docs-content :global(blockquote p) {
    margin: 0;
  }

  /* ---- Screenshots: one per theme, the one matching the site's shows ---- */
  .docs-content :global(.shot) {
    margin: 12px 0 28px;
  }
  .docs-content :global(.shot img) {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }
  .docs-content :global(.shot figcaption) {
    margin-top: 10px;
    font-size: 14px;
    color: var(--muted);
  }
  .docs-content :global(.shot .for-dark) {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .docs-content :global(.shot .for-light) {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .docs-content :global(.shot .for-dark) {
      display: block;
    }
  }
  :global(:root[data-theme='dark']) .docs-content :global(.shot .for-light) {
    display: none;
  }
  :global(:root[data-theme='dark']) .docs-content :global(.shot .for-dark) {
    display: block;
  }

  /* ---- Previous and next: the site's pixel buttons, the page's name on them ---- */
  .docs-pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  .pager-side {
    display: grid;
    justify-items: start;
    gap: 10px;
  }
  .pager-side.next {
    justify-items: end;
    margin-left: auto;
  }
  .pager-label {
    font:
      400 12px/1 'Silkscreen',
      var(--mono);
    color: var(--muted);
    text-transform: uppercase;
  }
  .pager-arrow {
    display: inline-flex;
  }

  @media (max-width: 860px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 24px;
    }
    /* On a phone the table of contents comes first, as a plain list. */
    .docs-side {
      position: static;
      padding: 0 0 20px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .docs-nav {
      max-height: none;
    }
  }
</style>
