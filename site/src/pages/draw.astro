  /*
   * Each guide covers the whole box with its line on one edge, and moves with transform (the GPU
   * does it, no layout): a percentage of its own size is then a percentage of the box.
   * The sheet is 46×32 art pixels after the 14 px rulers: cells split at 15 and 31 across, 16 down.
   */
  .guide {
    position: absolute;
    inset: 0;
    opacity: 0;
    will-change: transform;
    /* Longhands: the shorthand without a name gets minified to "none". */
    animation-duration: 6s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-play-state: paused;
