    border-left: 1px solid light-dark(#e5402a, #ff6a4d);
  }
  .guide-v1 {
    animation-name: guide-right-1;
  }
  .guide-v2 {
    animation-name: guide-right-2;
  }
  @keyframes guide-down {
    0%,
    10% {
      transform: translateY(0);
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    30%,
    92% {
      /* 14 px + (100% − 14 px) × 16 / 32 */
      transform: translateY(calc(50% + 7px));
      opacity: 1;
    }
    100% {
      transform: translateY(calc(50% + 7px));
      opacity: 0;
    }
  }
  @keyframes guide-right-1 {
    0%,
    34% {
      transform: translateX(0);
      opacity: 0;
    }
    36% {
      opacity: 1;
    }
    52%,
    92% {
      /* 14 px + (100% − 14 px) × 15 / 46 */
      transform: translateX(calc(32.61% + 9.43px));
      opacity: 1;
    }
    100% {
      transform: translateX(calc(32.61% + 9.43px));
      opacity: 0;
    }
  }
  @keyframes guide-right-2 {
    0%,
    56% {
      transform: translateX(0);
      opacity: 0;
    }
    58% {
      opacity: 1;
    }
    74%,
    92% {
      /* 14 px + (100% − 14 px) × 31 / 46 */
      transform: translateX(calc(67.39% + 4.57px));
      opacity: 1;
    }
    100% {
      transform: translateX(calc(67.39% + 4.57px));
