---
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import GuideHero from '../components/GuideHero.astro';
import Nav from '../components/Nav.astro';
import SectionHead from '../components/SectionHead.astro';
import Base from '../layouts/Base.astro';
import '../styles/guide.css';
import { blue, green, pack, red, alpha } from '../../../src/engine/color';
import { flattenFrame } from '../../../src/engine/composite';
import { frameCount, DEFAULT_DURATION } from '../../../src/engine/frames';
import { renderGeometry, toSvg } from '../../../src/engine/export/svg';
import { fileFromJson } from '../../../src/storage/fileFormat';
import slimeFile from '../art/slime.baipix?raw';
import slimeUrl from '../art/slime.baipix?url';

const base = import.meta.env.BASE_URL;

// The slime's jump: one board, 14 frames, each rendered here at build time with its duration.
const [slime] = fileFromJson(slimeFile);
const { width: w, height: h } = slime;
const svgOf = (pixels: Uint32Array) => toSvg(pixels, w, h, renderGeometry(w, h, 1, 0));
const frames = Array.from({ length: frameCount(slime) }, (_, f) => ({
  svg: svgOf(flattenFrame(slime, f)),
  duration: slime.frames?.[f].duration ?? DEFAULT_DURATION,
}));
const total = frames.reduce((sum, f) => sum + f.duration, 0);

/**
 * The onion skin as the editor shows it, on the slime alone (its sky and ground hidden): the frames
 * around the shown one under it, half tinted, red before and blue after.
 */
const character = slime.layers.filter((l) => !['Sky', 'Ground'].includes(l.name));
const alone = { ...slime, layers: character };
const ONION_AT = 4;
const around = [ONION_AT - 1, ONION_AT, ONION_AT + 1].map((f) =>
  flattenFrame(alone, f, { includeBackground: false }),
);
// Cropped around the slime on the three frames, with a little room.
let [x0, y0, x1, y1] = [w, h, 0, 0];
around.forEach((pixels) =>
  pixels.forEach((c, i) => {
    if (alpha(c) === 0) return;
    const x = i % w;
    const y = Math.floor(i / w);
    [x0, y0, x1, y1] = [Math.min(x0, x), Math.min(y0, y), Math.max(x1, x), Math.max(y1, y)];
  }),
);
[x0, y0, x1, y1] = [
  Math.max(0, x0 - 2),
  Math.max(0, y0 - 2),
  Math.min(w - 1, x1 + 2),
  Math.min(h - 1, y1 + 1),
];
const [cw, ch] = [x1 - x0 + 1, y1 - y0 + 1];
const cropSvg = (pixels: Uint32Array) => {
  const out = new Uint32Array(cw * ch);
  for (let y = 0; y < ch; y++) out.set(pixels.subarray((y0 + y) * w + x0, (y0 + y) * w + x0 + cw), y * cw);
  return toSvg(out, cw, ch, renderGeometry(cw, ch, 1, 0));
};
const tint = (pixels: Uint32Array, [tr, tg, tb]: number[]) =>
  pixels.map((c) =>
    alpha(c) === 0 ? 0 : pack((red(c) + tr) >> 1, (green(c) + tg) >> 1, (blue(c) + tb) >> 1, alpha(c)),
  );
const onion = {
  before: cropSvg(tint(around[0], [255, 59, 48])),
  after: cropSvg(tint(around[2], [47, 128, 255])),
  shown: cropSvg(around[1]),
};

const faq = [
  {
    q: 'Can I make pixel art animations in the browser?',
    a: 'Yes. Baipix has a timeline under the canvas: add frames, set how long each one shows, play it back, then export an animated GIF. It runs in your browser, with nothing to install.',
  },
  {
    q: 'How many frames does a pixel art animation need?',
    a: 'Fewer than you think. A walk cycle often has 4 to 8 frames, an idle loop 2 to 4. The slime on this page jumps in 14, some held longer than others.',
  },
  {
    q: 'Can each frame have its own duration?',
    a: 'Yes. Every frame has its own duration in milliseconds, so a pose can hold while the fast moves flash by. The GIF export keeps them.',
  },
  {
    q: 'What is onion skinning?',
    a: 'Showing the frames before and after the one you draw, faded under it, so you can see where things come from and where they go. Baipix tints them red before and blue after.',
  },
  {
    q: 'Can I export a sprite sheet for a game?',
    a: 'Animated GIF is there today. For a game engine, Layers + sprite sheet already exports a sheet with its TexturePacker JSON.',
  },
  {
    q: 'Is it free?',
    a: 'Yes. Baipix is free and open source (MIT). It runs in your browser, with no account, and your drawings stay on your device.',
  },
];
---

<Base
  title="Pixel art animation · Frames, onion skin and GIF export | Baipix"
  description="Animate pixel art in your browser, for free: a timeline of frames, a duration for each one, onion skin to see the frames around, playback, and animated GIF export."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  }}
>
  <Nav />

  <main class="guide" data-tone="animation">
    <GuideHero
      eyebrow="Pixel art animation"
      title="Pixel art animation"
      open={slimeUrl}
      more={{ href: '#timeline', text: 'The tools' }}
    >
      Baipix has a timeline under the canvas: frames you add, reorder and time one by one, onion skin to see
      the frames around, and playback as you draw. Then export it as an animated GIF.
    </GuideHero>

    <section class="showcase container" aria-label="A slime jumping, frame by frame">
      <figure class="frame showcase-art">
        <div class="player" data-player data-durations={JSON.stringify(frames.map((f) => f.duration))}>
          <div class="player-stage" role="img" aria-label="A green slime squashes, jumps and lands">
            {frames.map((f, i) => (
              <div class="pix player-frame" data-frame={i} hidden={i > 0} set:html={f.svg} />
            ))}
          </div>
          <ol class="strip" aria-label="The frames">
            {frames.map((f, i) => (
              <li class="strip-cell" data-cell={i} aria-current={i === 0 ? 'true' : undefined}>
                <div class="pix" set:html={f.svg} />
                <span>{f.duration} ms</span>
              </li>
            ))}
          </ol>
          <button type="button" class="btn player-toggle" data-toggle aria-pressed="false">
            Pause
          </button>
        </div>
        <figcaption class="muted">
          A slime drawn and animated in Baipix: 14 frames, {total} ms in all. The squash before the jump and
          the hang at the top hold longest. Open the editor to play it and change it.
        </figcaption>
      </figure>
    </section>

    <section id="timeline" class="cards container">
      <SectionHead label="The tools" />
      <h2>Frames, under the canvas.</h2>
      <div class="card-grid">
        <article class="card">
          <h3>The timeline</h3>
          <p class="muted">
            Animate, or Shift+A, opens it under the canvas: one row per layer, one column per frame. Click a
            cell to draw there.
          </p>
        </article>
        <article class="card">
          <h3>New frames from the last</h3>
          <p class="muted">
            Alt+N adds a frame that copies the one you're on, so you only redraw what moves. Drag frames to
            reorder them.
          </p>
        </article>
        <article class="card">
          <h3>A duration per frame</h3>
          <p class="muted">
            Each frame shows for as long as you set, from 10 ms to 10 s. Hold the key poses, flash the fast
            ones.
          </p>
        </article>
        <article class="card">
          <h3>Play as you draw</h3>
          <p class="muted">
            Enter plays and pauses, comma and period step through the frames. The preview panel plays along,
            at its own size.
          </p>
        </article>
      </div>
    </section>

    <section id="onion" class="cards container">
      <SectionHead label="Onion skin" />
      <h2>See where it comes from.</h2>
      <div class="onion-block">
        <figure class="frame">
          <div
            class="onion-art"
            role="img"
            aria-label="The slime rising, with the frame before tinted red and the frame after tinted blue under it"
          >
            <div class="pix onion-ghost" set:html={onion.before} />
            <div class="pix onion-ghost" set:html={onion.after} />
            <div class="pix" set:html={onion.shown} />
          </div>
        </figure>
        <div class="onion-text">
          <p class="muted">
            The onion skin shows the frames around the one you draw, faded under it: red for the ones before,
            blue for the ones after. Up to five on each side, fainter the further they are, with the opacity
            you pick.
          </p>
          <p class="muted">
            Turn it on from the timeline. It never ends up in an export, it's only there to draw by.
          </p>
        </div>
      </div>
    </section>

    <section id="gif" class="cards container">
      <SectionHead label="Export" />
      <h2>An animated GIF, ready to share.</h2>
      <div class="card-grid">
        <article class="card">
          <h3>Every frame, its timing</h3>
          <p class="muted">The GIF keeps each frame's duration and loops forever.</p>
        </article>
        <article class="card">
          <h3>Sharp at any size</h3>
          <p class="muted">
            Pixel size from 1× to 32×, with the pixel gap if you use one. No blur, the pixels stay square.
          </p>
        </article>
        <article class="card">
          <h3>Transparent or not</h3>
          <p class="muted">With the board's background, or without it, for a sprite on any page.</p>
        </article>
        <article class="card">
          <h3>Every board at once</h3>
          <p class="muted">All boards exports one GIF per board, in a .zip: each animation of a character.</p>
        </article>
      </div>
    </section>

    <section id="how" class="steps container">
      <SectionHead label="How to start" />
      <h2>From one pose to a loop.</h2>
      <ol class="step-list">
        <li>
          <span class="step-n">1</span>
          <div>
            <h3>Draw the first pose</h3>
            <p class="muted">
              The background on its own layer, the character on others. Only the layers that move change from
              frame to frame.
            </p>
          </div>
        </li>
        <li>
          <span class="step-n">2</span>
          <div>
            <h3>Add the key frames</h3>
            <p class="muted">
              Alt+N copies the frame, then move or redraw what changes. Turn on the onion skin to keep the
              motion even.
            </p>
          </div>
        </li>
        <li>
          <span class="step-n">3</span>
          <div>
            <h3>Time it and export</h3>
            <p class="muted">
              Press Enter to watch it loop, adjust the durations until it feels right, then export a GIF.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <section id="tips" class="cards container">
      <SectionHead label="Tips" />
      <h2>Lively pixel art animation.</h2>
      <div class="card-grid">
        <article class="card">
          <h3>Squash and stretch</h3>
          <p class="muted">
            Flatten before a jump, stretch on the way up and down. The slime keeps the same amount of green.
          </p>
        </article>
        <article class="card">
          <h3>Few frames, good timing</h3>
          <p class="muted">
            Four well-timed frames read better than twelve even ones. Change durations before adding frames.
          </p>
        </article>
        <article class="card">
          <h3>Anticipate</h3>
          <p class="muted">
            A small move the other way before the big one: down before up, back before a throw.
          </p>
        </article>
        <article class="card">
          <h3>Loop cleanly</h3>
          <p class="muted">
            The last frame should lead back into the first. Watch the loop a few times with Enter.
          </p>
        </article>
      </div>
      <p class="muted guide-more">
        Every shortcut is in the <a href={`${base}docs/`}>docs</a>. To bring a frame into a design, see
        <a href={`${base}pixel-art-to-svg/`}>Pixel art to SVG</a>.
      </p>
    </section>

    <Faq items={faq} />

    <Cta />
  </main>

  <Footer />
</Base>

<script>
  // Plays the slime with each frame's own duration, and marks its cell in the strip. With reduced
  // motion, the first frame stays; the button plays it anyway.
  for (const player of document.querySelectorAll<HTMLElement>('[data-player]')) {
    const durations: number[] = JSON.parse(player.dataset.durations ?? '[]');
    const shown = [...player.querySelectorAll<HTMLElement>('[data-frame]')];
    const cells = [...player.querySelectorAll<HTMLElement>('[data-cell]')];
    const toggle = player.querySelector<HTMLButtonElement>('[data-toggle]')!;
    let frame = 0;
    let timer = 0;
    const show = (f: number) => {
      shown[frame].hidden = true;
      cells[frame].removeAttribute('aria-current');
      frame = f;
      shown[frame].hidden = false;
      cells[frame].setAttribute('aria-current', 'true');
    };
    const tick = () => {
      show((frame + 1) % durations.length);
      timer = window.setTimeout(tick, durations[frame]);
    };
    const set = (playing: boolean) => {
      clearTimeout(timer);
      if (playing) timer = window.setTimeout(tick, durations[frame]);
      toggle.textContent = playing ? 'Pause' : 'Play';
      toggle.setAttribute('aria-pressed', String(!playing));
    };
    toggle.addEventListener('click', () => set(toggle.textContent === 'Play'));
    set(!matchMedia('(prefers-reduced-motion: reduce)').matches);
  }
</script>

<style>
  .showcase {
    margin-top: 64px;
  }
  .showcase-art {
    gap: 20px;
  }
  .player {
    display: grid;
    justify-items: center;
    gap: 16px;
    width: min(100%, 880px);
  }
  .player-stage {
    display: grid;
    width: 100%;
  }
  .player-frame {
    grid-area: 1 / 1;
  }
  /* The frames under the drawing, as in the editor's timeline: the one shown is outlined. */
  .strip {
    display: grid;
    grid-template-columns: repeat(14, minmax(0, 1fr));
    gap: 6px;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .strip-cell {
    display: grid;
    gap: 4px;
    font-size: 11px;
    text-align: center;
    color: var(--tint-ink, var(--muted));
  }
  .strip-cell span {
    white-space: nowrap;
  }
  .strip-cell .pix {
    outline: 2px solid transparent;
    outline-offset: 1px;
  }
  .strip-cell[aria-current] .pix {
    outline-color: var(--accent);
  }
  .player-toggle {
    min-width: 96px;
  }
  .showcase-art figcaption {
    max-width: 640px;
    text-align: center;
    font-size: 14px;
  }
  .onion-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px;
    margin-top: 40px;
    align-items: center;
  }
  .onion-art {
    display: grid;
    width: min(100%, 320px);
  }
  .onion-art > .pix {
    grid-area: 1 / 1;
  }
  .onion-ghost {
    opacity: 0.4;
  }
  .onion-text {
    display: grid;
    gap: 16px;
  }
  .guide-more {
    margin-top: 32px;
  }
  .guide-more a {
    color: var(--text);
    text-decoration: underline;
  }
  @media (max-width: 760px) {
    .onion-block {
      grid-template-columns: minmax(0, 1fr);
    }
    .strip {
      grid-template-columns: repeat(7, minmax(0, 1fr));
    }
    .strip-cell {
      font-size: 10px;
    }
  }
</style>
