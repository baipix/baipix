---
import ArrowIcon from '../components/ArrowIcon.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import SectionHead from '../components/SectionHead.astro';
import Base from '../layouts/Base.astro';
import { galleryDoc } from '../gallery';
import { APP_URL } from '../links';
import { toHex } from '../../../src/engine/color';
import { flatten } from '../../../src/engine/composite';
import { renderGeometry, toSvg } from '../../../src/engine/export/svg';

const base = import.meta.env.BASE_URL;

// The starfighter from the gallery, as Baipix exports it, and as a naive converter would: one
// square per pixel. The numbers on the page are measured here, at build time.
const doc = galleryDoc('starfighter.baipix');
const pixels = flatten(doc, { includeBackground: false });
const { width: w, height: h } = doc;
const svg = toSvg(pixels, w, h, renderGeometry(w, h, 1, 0));
const opaque = [...pixels].filter((c) => c >>> 24).length;
const colors = new Set([...pixels].filter((c) => c >>> 24)).size;
const naive = [
  `<svg xmlns="http://www.w3.org/2000/svg" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}">`,
  ...[...pixels].flatMap((c, i) =>
    c >>> 24 ? [`<rect x="${i % w}" y="${Math.floor(i / w)}" width="1" height="1" fill="${toHex(c)}"/>`] : [],
  ),
  '</svg>',
].join('\n');
const kb = (s: string) => (new TextEncoder().encode(s).length / 1024).toFixed(1);
const smaller = Math.round((1 - svg.length / naive.length) * 100);
// The first lines of the real file, for the code sample.
const lines = svg.trim().split('\n');
const sample = [
  lines[0],
  ...lines.slice(1, 4).map((l) => (l.length > 96 ? `${l.slice(0, 93)}…"/>` : l)),
  '…',
  '</svg>',
].join('\n');
// The same ship with a gap between its pixels, the LED look.
const gapSvg = toSvg(pixels, w, h, renderGeometry(w, h, 8, 2));

const faq = [
  {
    q: 'Can I convert a PNG of pixel art to SVG?',
    a: 'Yes. Open the PNG in Baipix (File › Import an image, or drop it on the canvas). If it was scaled up, like a screenshot at 800%, Baipix finds its pixel grid and gives you back the real pixels first. Then Export › SVG.',
  },
  {
    q: 'Is it free?',
    a: 'Yes. Baipix is free and open source (MIT), runs in your browser, and needs no account. Your drawings stay on your device.',
  },
  {
    q: 'Will the SVG look right in Figma or Illustrator?',
    a: 'Yes: Copy as SVG (Ctrl+Shift+C) and paste it into the canvas. Every color is one shape you can recolor in one click, the layers stay as groups, and there are no hairlines between pixels.',
  },
  {
    q: 'Why not one square per pixel?',
    a: 'A square per pixel makes big files that are slow to edit, and many apps draw faint lines between the squares when they scale them. Baipix merges neighboring pixels of the same color into one path per color.',
  },
  {
    q: 'Can I get it as code?',
    a: 'Yes. The </> button next to Export gives the drawing as a React component, CSS, JSON or the SVG itself, to copy or download.',
  },
];
---

<Base
  title="Pixel art to SVG · Clean vector from pixel art, free | Baipix"
  description="Turn pixel art into clean SVG for free: one path per color, neighboring pixels merged, no seams, layers kept. Draw or open a PNG in Baipix, then paste the vector straight into Figma or Illustrator."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  }}
>
  <Nav />

  <main data-tone="export">
    <section class="hero container">
      <p class="eyebrow">Pixel art to SVG</p>
      <h1>
        Pixel art to SVG, the clean way<span class="pixel-dot" aria-hidden="true"></span>
      </h1>
      <p class="lead">
        Baipix turns pixel art into vector that's light, sharp at any size and easy to edit: one path per
        color, neighboring pixels merged, no seams. Draw it, or open a PNG, and paste it straight into your
        design tool.
      </p>
      <div class="hero-actions">
        <a class="btn btn-dark" href={APP_URL}>
          Open the editor <ArrowIcon />
        </a>
        <a class="btn" href="#how">
          How it works
        </a>
      </div>
    </section>

    <section class="demo container" aria-label="The same sprite, exported">
      <figure class="frame demo-art">
        <div
          class="pix"
          set:html={svg}
          role="img"
          aria-label="A 32 by 32 pixel starfighter, exported to SVG"
        />
      </figure>
      <div class="demo-facts">
        <dl class="facts">
          <div>
            <dt>Pixels</dt>
            <dd>{opaque}</dd>
          </div>
          <div>
            <dt>Colors, so paths</dt>
            <dd>{colors}</dd>
          </div>
          <div>
            <dt>Baipix SVG</dt>
            <dd>{kb(svg)} KB</dd>
          </div>
          <div>
            <dt>A square per pixel</dt>
            <dd>{kb(naive)} KB</dd>
          </div>
        </dl>
        <p class="muted">
          The {w} × {h} starfighter from the gallery: {smaller}% smaller than a square per pixel, and {colors}{' '}
          shapes to recolor instead of {opaque}.
        </p>
        <pre class="code"><code>{sample}</code></pre>
      </div>
    </section>

    <section id="why" class="cards container">
      <SectionHead label="Why it's clean" />
      <h2>Vector made the pixel art way.</h2>
      <div class="card-grid">
        <article class="card">
          <h3>One path per color</h3>
          <p class="muted">
            Every color is a single shape. Recolor the whole sprite in one click in Figma, Illustrator or CSS.
          </p>
        </article>
        <article class="card">
          <h3>Pixels merged, no seams</h3>
          <p class="muted">
            Neighboring pixels of the same color become one run, drawn crisp. No faint lines between pixels
            when it's scaled, and small files.
          </p>
        </article>
        <article class="card">
          <h3>Layers kept</h3>
          <p class="muted">
            Each layer and group is a named group in the SVG, with its opacity and blend mode, so they stay
            apart once opened.
          </p>
        </article>
        <article class="card">
          <h3>Any size, or a gap</h3>
          <p class="muted">
            Pick the pixel size, 1× to 32×, and space the pixels apart for an LED or dot-matrix look, exported
            as real vector too.
          </p>
          <div
            class="pix gap-art"
            set:html={gapSvg}
            role="img"
            aria-label="The starfighter with a gap between its pixels"
          />
        </article>
      </div>
    </section>

    <section id="how" class="steps container">
      <SectionHead label="How it works" />
      <h2>Three steps, in your browser.</h2>
      <ol class="step-list">
        <li>
          <span class="step-n">1</span>
          <div>
            <h3>Draw, or open your pixel art</h3>
            <p class="muted">
              Draw in Baipix, or import a PNG or any image of pixel art. A screenshot scaled up is fine:
              Baipix finds its pixel grid and recovers the real pixels.
            </p>
          </div>
        </li>
        <li>
          <span class="step-n">2</span>
          <div>
            <h3>Export as SVG</h3>
            <p class="muted">
              Export, then SVG, with the pixel size you want. Or Copy as SVG (Ctrl+Shift+C) to skip the file.
            </p>
          </div>
        </li>
        <li>
          <span class="step-n">3</span>
          <div>
            <h3>Paste it anywhere</h3>
            <p class="muted">
              Paste into Figma or Illustrator, put it on a web page, or take it as a React component or CSS
              with the code button next to Export.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <section id="faq" class="faq container">
      <SectionHead label="Questions" />
      <h2>Pixel art to SVG, answered.</h2>
      <div class="faq-list">
        {faq.map(({ q, a }) => (
          <details>
            <summary>{q}</summary>
            <p class="muted">{a}</p>
          </details>
        ))}
      </div>
    </section>

    <Cta />
  </main>

  <Footer />
</Base>

<style>
  .hero {
    padding-top: 72px;
  }
  .eyebrow {
    font:
      400 16px/1 'Silkscreen',
      var(--mono);
    color: var(--muted);
    text-transform: uppercase;
  }
  h1 {
    max-width: 16ch;
    margin-top: 20px;
    font-size: clamp(40px, 6.4vw, 68px);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }
  .pixel-dot {
    display: inline-block;
    width: 0.16em;
    height: 0.16em;
    margin-left: 0.06em;
    background: var(--accent);
  }
  .lead {
    max-width: 600px;
    margin-top: 24px;
    font-size: 18px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  h2 {
    margin-top: 40px;
  }
  h3 {
    font-size: 18px;
    letter-spacing: -0.01em;
  }

  /* ---- The sprite, and its numbers ---- */
  .demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    margin-top: 64px;
  }
  .frame {
    display: grid;
    place-items: center;
    margin: 0;
    padding: 48px;
    background: linear-gradient(160deg, var(--tint-a), var(--tint-b));
  }
  .pix :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    image-rendering: pixelated;
  }
  .demo-art .pix {
    width: min(100%, 360px);
  }
  .demo-facts {
    display: grid;
    align-content: center;
    gap: 20px;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .facts div {
    padding: 16px 18px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    font-size: 13px;
    color: var(--muted);
  }
  .facts dd {
    margin: 4px 0 0;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .code {
    margin: 0;
    padding: 16px 18px;
    overflow-x: auto;
    background: var(--surface);
    font: 400 12px/1.7 var(--mono);
  }

  /* ---- Why it's clean ---- */
  .cards,
  .steps,
  .faq {
    padding-top: 120px;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 40px;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px 28px 36px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .gap-art {
    width: 160px;
    margin-top: 8px;
  }

  /* ---- How it works ---- */
  .step-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }
  .step-list li {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .step-list div {
    display: grid;
    gap: 10px;
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    background: var(--accent);
    color: var(--bg);
    font:
      400 16px/1 'Silkscreen',
      var(--mono);
  }

  /* ---- Questions ---- */
  .faq-list {
    margin-top: 40px;
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    padding: 20px 0;
    font-size: 18px;
    font-weight: 500;
    cursor: pointer;
  }
  details p {
    max-width: 720px;
    padding-bottom: 20px;
  }

  @media (max-width: 760px) {
    /* minmax(0, …): the code's long lines scroll inside it instead of widening the page. */
    .demo,
    .card-grid,
    .step-list {
      grid-template-columns: minmax(0, 1fr);
    }
    .frame {
      padding: 28px;
    }
  }
</style>
