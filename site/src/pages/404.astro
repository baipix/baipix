---
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;

/*
 * A pixel art scene in one soft color: a bomb falling on a city, and a shop sign that reads 404.
 * Depth comes from layers: clouds, far silhouettes, mid buildings, detailed buildings in
 * front, and a dense ground. It's generated here on a grid (1 = ink, 0 = paper), with a fixed
 * random seed so every build draws the same thing.
 */
const W = 160;
const H = 96;
const ink = Array.from({ length: H }, () => new Uint8Array(W));
const set = (x: number, y: number, v = 1) => {
  if (x >= 0 && y >= 0 && x < W && y < H) ink[y][x] = v;
};
const rect = (x: number, y: number, w: number, h: number, v = 1) => {
  for (let j = y; j < y + h; j++) for (let i = x; i < x + w; i++) set(i, j, v);
};
const frame = (x: number, y: number, w: number, h: number, v = 1) => {
  rect(x, y, w, 1, v);
  rect(x, y + h - 1, w, 1, v);
  rect(x, y, 1, h, v);
  rect(x + w - 1, y, 1, h, v);
};
const stamp = (rows: string[], x0: number, y0: number, v = 1) =>
  rows.forEach((row, y) => [...row].forEach((c, x) => c === '#' && set(x0 + x, y0 + y, v)));

// Ordered dithering (Bayer 4 × 4): `level` 0..1 is how much ink an area gets.
const BAYER = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5];
const dithered = (x: number, y: number, level: number) => level * 16 > BAYER[(y % 4) * 4 + (x % 4)] + 0.5;

// Deterministic randomness (mulberry32).
let seed = 404;
const random = () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const between = (a: number, b: number) => a + Math.floor(random() * (b - a + 1));

const SIDEWALK = 82;

// 1. Clouds: outlined puffs with a dithered shadow on their lower half. The sky is the page itself.
const clouds = [
  [
    [96, 34, 13],
    [110, 28, 12],
    [122, 36, 11],
    [84, 42, 10],
    [104, 44, 12],
    [134, 44, 9],
  ],
  [
    [14, 20, 7],
    [24, 16, 8],
    [34, 21, 6],
  ],
  [
    [146, 10, 6],
    [156, 14, 7],
  ],
  [
    [44, 44, 7],
    [56, 40, 8],
    [66, 46, 7],
  ],
];
for (const discs of clouds) {
  const reach = (x: number, y: number) =>
    Math.max(...discs.map(([cx, cy, r]) => r - Math.hypot(x - cx, y - cy)));
  const top = Math.min(...discs.map(([, cy, r]) => cy - r));
  const bottom = Math.max(...discs.map(([, cy, r]) => cy + r));
  for (let y = 0; y < SIDEWALK; y++)
    for (let x = 0; x < W; x++) {
      const k = reach(x, y);
      if (k < 0) continue;
      const shade = Math.max(0, (y - top) / (bottom - top) - 0.55) * 1.2;
      set(x, y, k < 1 || dithered(x, y, shade) ? 1 : 0);
    }
}

// 2. Far skyline: light dithered silhouettes, the farther the lighter.
for (let x = 0; x < W;) {
  const w = between(6, 13);
  const top = between(50, 62);
  rect(x, top, w, 1);
  for (let y = top + 1; y < SIDEWALK; y++) for (let i = x; i < x + w; i++) if (dithered(i, y, 0.3)) set(i, y);
  if (random() < 0.3) rect(x + Math.floor(w / 2), top - 3, 1, 3); // antenna
  x += w;
}

// 3. Mid buildings: paper facades, ink outlines, rows of dark windows.
const building = (x: number, top: number, w: number, windows: 'small' | 'tall') => {
  rect(x, top, w, SIDEWALK - top, 0);
  frame(x, top, w, SIDEWALK - top + 1);
  rect(x - 1, top, w + 2, 1);
  const [ww, wh, sx, sy] = windows === 'small' ? [2, 2, 4, 4] : [2, 3, 4, 5];
  for (let y = top + 3; y < SIDEWALK - 5; y += sy)
    for (let i = x + 2; i + ww <= x + w - 2; i += sx) if (random() > 0.15) rect(i, y, ww, wh);
};
for (const [x, top, w] of [
  [30, 58, 14],
  [46, 54, 12],
  [100, 56, 16],
  [116, 62, 12],
])
  building(x, top, w, 'small');

// 4. Front buildings, on the sides: bigger windows with sills, balconies, and a shaded side.
const tower = (x: number, top: number, w: number, shadeRight: boolean) => {
  rect(x, top, w, SIDEWALK - top, 0);
  frame(x, top, w, SIDEWALK - top + 1);
  rect(x - 1, top, w + 2, 2);
  for (let y = top + 4, floor = 0; y < SIDEWALK - 9; y += 7, floor++) {
    for (let i = x + 3; i + 4 <= x + w - 3; i += 6) {
      frame(i, y, 4, 5);
      rect(i + 1, y + 1, 2, 3, random() > 0.5 ? 1 : 0);
      rect(i - 1, y + 5, 6, 1); // sill
    }
    if (floor % 2 === 1) for (let i = x + 2; i < x + w - 2; i++) if (i % 2 === 0) set(i, y + 6); // balcony rail
  }
  // Shop window and door on the ground floor.
  frame(x + 3, SIDEWALK - 7, w - 12, 5);
  rect(x + w - 7, SIDEWALK - 8, 4, 8);
  // Shaded side, a strip of dither on the side away from the light.
  const sx = shadeRight ? x + w - 4 : x + 1;
  for (let y = top + 2; y < SIDEWALK; y++)
    for (let i = sx; i < sx + 3; i++) if (dithered(i, y, 0.35)) set(i, y);
};
tower(-2, 44, 32, true);
tower(128, 40, 34, false);

// The 404 shop, in the middle: a striped awning, a dark sign with light digits, a door and a window.
const shop = { x: 62, top: 64, w: 36 };
rect(shop.x, shop.top, shop.w, SIDEWALK - shop.top, 0);
frame(shop.x, shop.top, shop.w, SIDEWALK - shop.top + 1);
rect(shop.x - 1, shop.top, shop.w + 2, 2);
rect(shop.x + 7, shop.top + 3, 22, 9);
const DIGITS: Record<string, string[]> = {
  4: ['#..#', '#..#', '#..#', '####', '...#', '...#', '...#'],
  0: ['.##.', '#..#', '#..#', '#..#', '#..#', '#..#', '.##.'],
};
['4', '0', '4'].forEach((d, i) => stamp(DIGITS[d], shop.x + 9 + i * 6, shop.top + 4, 0));
for (let x = shop.x + 1; x < shop.x + shop.w - 1; x++)
  for (let y = shop.top + 13; y < shop.top + 15; y++) if (x % 4 < 2 || y === shop.top + 14) set(x, y);
frame(shop.x + 4, SIDEWALK - 6, 12, 5);
stamp(['#...#...#.', '..#...#...'], shop.x + 5, SIDEWALK - 5);
rect(shop.x + shop.w - 10, SIDEWALK - 7, 5, 7);
set(shop.x + shop.w - 7, SIDEWALK - 4, 0); // door handle

// 5. The bomb, falling in front of the big cloud: a highlight, a neck, a fuse, and dashed trails.
const bomb = { x: 104, y: 40, r: 8 };
for (let y = -bomb.r - 1; y <= bomb.r + 1; y++)
  for (let x = -bomb.r - 1; x <= bomb.r + 1; x++) {
    const d = x * x + y * y;
    if (d <= bomb.r * bomb.r + 3) set(bomb.x + x, bomb.y + y, 1);
    else if (d <= (bomb.r + 1) * (bomb.r + 1) + 3) set(bomb.x + x, bomb.y + y, 0);
  }
stamp(['..###', '.#...', '#....', '#....'], bomb.x - 6, bomb.y - 6, 0);
rect(bomb.x + 3, bomb.y - 10, 4, 3);
stamp(['...#', '..#.', '.#..'], bomb.x + 5, bomb.y - 13);
for (const dx of [-5, 0, 5])
  for (let y = 0; y < bomb.y - bomb.r - 4 - Math.abs(dx) / 2; y++) if (y % 5 < 3) set(bomb.x + dx, y);
// A small plane far away, and two birds.
stamp(['#.....#', '#######', '..###..', '...#...'], 30, 30);
stamp(['#.#', '.#.'], 70, 26);
stamp(['#.#', '.#.'], 76, 23);

// 6. Sidewalk and ground: a curb, then grass strokes that thicken toward the bottom.
rect(0, SIDEWALK, W, 1);
rect(0, SIDEWALK + 1, W, 3, 0);
rect(0, SIDEWALK + 4, W, 1);
for (let y = SIDEWALK + 5; y < H; y++)
  for (let x = 0; x < W; x++) {
    const density = 0.12 + ((y - SIDEWALK - 5) / (H - SIDEWALK - 5)) * 0.3;
    if (random() < density) {
      set(x, y);
      if (random() < 0.35) set(x, y + 1);
    } else set(x, y, 0);
  }

// Two frames for the spark on the fuse, in ink over the light cloud.
const spark = (rows: string[]) => {
  const g = Array.from({ length: H }, () => new Uint8Array(W));
  rows.forEach((row, y) => [...row].forEach((c, x) => c === '#' && (g[bomb.y - 16 + y][bomb.x + 8 + x] = 1)));
  return g;
};
const sparkA = spark(['#...#', '.#.#.', '..#..', '.#.#.', '#...#']);
const sparkB = spark(['..#..', '..#..', '#####', '..#..', '..#..']);
// Clear the spark's area so both frames show on paper.
for (let y = -1; y <= 5; y++) for (let x = -1; x <= 5; x++) set(bomb.x + 8 + x, bomb.y - 16 + y, 0);

// The city fades out toward the sides, and the ground toward the bottom, with a dither.
const smooth = (t: number) => {
  const c = Math.min(1, Math.max(0, t));
  return c * c * (3 - 2 * c);
};
const visible = Array.from({ length: H }, (_, y) =>
  Uint8Array.from({ length: W }, (_, x) => {
    const f = smooth(Math.min(x, W - 1 - x) / 18) * smooth((H - 1 - y) / 8);
    return dithered(x, y, f) ? 1 : 0;
  }),
);

// One rectangle per horizontal run keeps the SVG small. `value` picks ink (1) or paper (0) cells.
const path = (g: Uint8Array[], value = 1) =>
  g
    .map((row, y) => {
      let d = '';
      const on = (x: number) => visible[y][x] === 1 && row[x] === value;
      for (let x = 0; x < W; x++) {
        if (!on(x)) continue;
        const start = x;
        while (x < W && on(x)) x++;
        d += `M${start} ${y}h${x - start}v1h-${x - start}z`;
      }
      return d;
    })
    .join('');
---

<Base
  title="Page not found · Baipix"
  description="This page doesn't exist. Head back to the Baipix home page."
  noindex
>
  <header class="top container">
    <a class="brand" href={base} aria-label="Baipix home">
      <Logo size={18} />
      <span>Baipix</span>
    </a>
    <ThemeToggle />
  </header>

  <main class="lost container">
    <svg
      class="scene"
      viewBox={`0 0 ${W} ${H}`}
      shape-rendering="crispEdges"
      role="img"
      aria-label="A bomb falling on a pixel city, above a shop sign that reads 404"
    >
      <path class="ink" d={path(ink)}></path>
      <path class="ink spark spark-a" d={path(sparkA)}></path>
      <path class="ink spark spark-b" d={path(sparkB)}></path>
    </svg>
    <p class="status">404 · Page not found</p>
    <h1>Boom. Not a pixel left.</h1>
    <p class="muted">This page doesn't exist, or it moved. Let's get you back somewhere safe.</p>
    <a class="btn btn-dark" href={base}>
      Back to home
    </a>
  </main>
  <Footer />
</Base>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .lost {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 24px 0 0;
    text-align: center;
  }
  /* One soft color, gray on light and light gray on dark, with the page as the sky. */
  .scene {
    width: 640px;
    height: 384px;
    max-width: 100%;
    height: auto;
  }
  .ink {
    fill: var(--muted);
  }
  .status {
    margin-top: 36px;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
  }
  h1 {
    margin-top: 12px;
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.1;
  }
  .lost p.muted {
    max-width: 420px;
    margin-top: 12px;
    font-size: 17px;
  }
  .lost .btn {
    margin-top: 32px;
  }
  /* The spark flickers between two frames, like an old game. */
  .spark-b {
    visibility: hidden;
  }
  @media (prefers-reduced-motion: no-preference) {
    .spark-a {
      animation: spark 0.5s steps(1) infinite;
    }
    .spark-b {
      animation: spark 0.5s steps(1) infinite -0.25s;
    }
  }
  @keyframes spark {
    0% {
      visibility: visible;
    }
    50% {
      visibility: hidden;
    }
  }
  @media (max-width: 680px) {
    .scene {
      width: 320px;
    }
  }
</style>
