---
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
import Gallery from '../components/Gallery.astro';
import Nav from '../components/Nav.astro';
import PixelIcon from '../components/PixelIcon.astro';
import SectionHead from '../components/SectionHead.astro';
import Base from '../layouts/Base.astro';
import { APP_URL, REPO_URL } from '../links';

const base = import.meta.env.BASE_URL;
const ARROW = ['...#...', '....#..', '.....#.', '#######', '.....#.', '....#..', '...#...'];
const clone = 'git clone https://github.com/baipix/baipix.git\ncd baipix\nnpm install\nnpm run dev';

const features = [
  {
    title: 'Familiar from the first click',
    tone: 'start',
    text: 'A menu bar with every shortcut, a command palette on Ctrl+K, templates to start from, and a short tour the first time.',
    icon: ['#######', '#.#...#', '#.#...#', '#.#...#', '#.#...#', '#.#...#', '#######'],
  },
  {
    title: 'Clean vector export',
    tone: 'export',
    text: 'Every color becomes a single SVG path. Copy as SVG and paste it straight into Figma or Illustrator, or export a PNG from 1× to 32× with a live preview.',
    icon: ['##.....', '##.....', '..#....', '...#...', '....#..', '.....##', '.....##'],
  },
  {
    title: 'Pixel gap rendering',
    tone: 'export',
    text: 'Space pixels apart for an LED or dot-matrix look, right on the canvas, and exported as real vector.',
    icon: ['#.#.#.#', '.......', '#.#.#.#', '.......', '#.#.#.#', '.......', '#.#.#.#'],
  },
  {
    title: 'Colors that follow the palette',
    tone: 'colors',
    text: 'Lighten and shade along the ramp of the color. Adjust hue and saturation in one pass, or remap a whole drawing to another palette, matched by nearest color or by lightness.',
    icon: ['......#', '.....##', '....###', '...####', '..#####', '.######', '#######'],
  },
  {
    title: 'Palettes and images from anywhere',
    tone: 'colors',
    text: 'Nineteen classic palettes (PICO-8, Game Boy, Endesga 32…), .hex and .gpl files, or one built from your drawing. Open a scaled-up screenshot of pixel art and get its real pixels back.',
    icon: ['###.###', '###.###', '###.###', '.......', '###.###', '###.#.#', '###.###'],
  },
  {
    title: 'Drawing, pixel by pixel',
    tone: 'draw',
    text: 'A pixel-perfect pencil with a stabilizer, a lasso fill, a spray, dithering patterns, shapes from lines to stars, brushes made from your own selection, and a 1px outline in one go.',
    icon: ['...#...', '..###..', '#######', '.#####.', '..###..', '.##.##.', '.#...#.'],
  },
  {
    title: 'Rework without new colors',
    tone: 'rework',
    text: 'Liquify pushes, grows or shrinks a part of the drawing, and Jumble shuffles pixels for texture. Both keep the edges sharp and the palette as it is. Blur can stay within the palette too.',
    icon: ['#......', '.#.....', '..#.#..', '...#...', '..#.#..', '.....#.', '......#'],
  },
  {
    title: 'Symmetry, guides and seamless tiles',
    tone: 'symmetry',
    text: 'Mirror around axes you drag anywhere, line up sprites with rulers and guides, and in tile preview strokes wrap around the edges, so textures repeat without a seam.',
    icon: ['#..#..#', '##.#.##', '###.###', '###.###', '###.###', '##.#.##', '#..#..#'],
  },
  {
    title: 'Layers, reference and preview',
    tone: 'layers',
    text: 'Layers like a design tool, with groups, blend modes, and handles to resize and rotate them. A reference image to trace over, and a floating preview that doubles as a minimap.',
    icon: ['#######', '.......', '.#####.', '.......', '..###..', '.......', '...#...'],
  },
];
---

<Base
  title="Baipix · Free online pixel art editor, export to SVG and Figma"
  description="Draw pixel art in your browser, for free: layers, palettes, symmetry, dithering, blend modes. Export clean SVG or PNG and paste it straight into Figma. Open source."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Baipix',
    description:
      'A free, open source pixel art editor in the browser, with the interface of a modern design tool and clean SVG export.',
    url: new URL(base, Astro.site).href,
    image: new URL(`${base}og.png`, Astro.site).href,
    applicationCategory: 'DesignApplication',
    operatingSystem: 'Any (web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    license: 'https://opensource.org/licenses/MIT',
    sameAs: [REPO_URL],
  }}
>
  <Nav />

  <main>
    <section class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="container hero-inner">
        <h1>
          Pixel art has never been this easy<span class="pixel-dot" aria-hidden="true"></span>
        </h1>
        <p class="lead">
          Baipix is a free, open source pixel art editor with the interface of a modern design tool. Draw
          pixel by pixel in your browser, then drop clean vector straight into your design files.
        </p>
        <div class="actions">
          <a class="btn btn-dark" href={APP_URL}>
            Open the editor
          </a>
          <a class="btn" href={REPO_URL}>
            View on GitHub
          </a>
        </div>
      </div>
      <div class="container">
        <figure class="shot">
          <img
            class="for-light"
            src={`${base}screenshot-light.png`}
            width="1440"
            height="900"
            alt="The Baipix editor with a pixel art sunset: the menu bar on top, layers and a floating preview on the left, tools at the bottom, properties on the right."
          />
          <img
            class="for-dark"
            src={`${base}screenshot-dark.png`}
            width="1440"
            height="900"
            alt="The Baipix editor with a pixel art sunset: the menu bar on top, layers and a floating preview on the left, tools at the bottom, properties on the right."
            loading="lazy"
          />
          <span class="shot-pixel" aria-hidden="true"></span>
        </figure>
      </div>
    </section>

    <section id="install" class="install container">
      <SectionHead label="Get started" />
      <h2>Up and running in seconds.</h2>
      <div class="install-grid">
        <div class="card">
          <h3>Use it in your browser</h3>
          <p class="muted">Nothing to install, no account. Your drawings stay on your device.</p>
          <a class="btn btn-dark" href={APP_URL}>
            Open the editor
          </a>
        </div>
        <div class="card">
          <h3>Run it locally</h3>
          <p class="muted">Clone the repository and start the dev server. Requires Node.js.</p>
          <div class="code">
            <pre><code>{clone}</code></pre>
            <button class="copy" type="button" data-copy={clone}>
              Copy
            </button>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="features container">
      <SectionHead label="Features" link={{ href: `${base}draw/`, text: 'Every tool in detail →' }} />
      <h2>Everything you need. Nothing you don't.</h2>
      <div class="feature-grid">
        {features.map((f) => (
          <article class="feature" data-tone={f.tone}>
            <PixelIcon rows={f.icon} size={24} />
            <h3>
              <a href={`${base}draw/#${f.tone}`}>{f.title}</a>
            </h3>
            <p class="muted">{f.text}</p>
            <span class="feature-arrow" aria-hidden="true">
              <PixelIcon rows={ARROW} size={14} />
            </span>
          </article>
        ))}
      </div>
    </section>

    <Gallery />

    <Cta />
  </main>

  <Footer />

  <script>
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Press Ctrl+C';
        }
        setTimeout(() => (button.textContent = 'Copy'), 1600);
      });
    }
  </script>
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    padding: 72px 0 0;
    overflow: hidden;
  }
  /* A faint pixel grid, like an empty canvas, fading out around the title. */
  .hero-grid {
    position: absolute;
    inset: 0 0 35%;
    background-image: radial-gradient(circle at 1px 1px, var(--dots) 1px, transparent 1.5px);
    background-size: 16px 16px;
    /* A mask only uses the alpha channel: #000 means fully visible, not a color. */
    mask-image: radial-gradient(ellipse 60% 70% at 50% 35%, #000 20%, transparent 75%);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  h1 {
    max-width: 14ch;
    font-size: clamp(40px, 7vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  /* The final period is a single square pixel. */
  .pixel-dot {
    display: inline-block;
    width: 0.16em;
    height: 0.16em;
    margin-left: 0.06em;
    background: currentColor;
  }
  .lead {
    max-width: 580px;
    text-wrap: balance;
    margin-top: 24px;
    font-size: 18px;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }
  /*
   * A pixel frame, like the buttons: a 2px edge minus its corners (drawn with offset shadows, so the
   * escaping pixel outside isn't clipped), and a solid side underneath.
   */
  .shot {
    --edge: var(--line-strong);
    position: relative;
    /* Room below for the side: the hero clips whatever overflows it. */
    margin: 64px 0 12px;
    padding: 10px;
    border: 0;
    border-radius: 0;
    background: var(--surface);
    box-shadow:
      0 -2px 0 0 var(--edge),
      -2px 0 0 0 var(--edge),
      2px 0 0 0 var(--edge),
      0 2px 0 0 var(--edge),
      0 10px 0 0 var(--edge);
  }
  .shot img {
    width: 100%;
    height: auto;
    border-radius: 0;
  }
  /* The screenshot follows the site theme: the OS setting, or the visitor's pick. */
  .shot .for-dark {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .shot .for-light {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .shot .for-dark {
      display: block;
    }
  }
  :global(:root[data-theme='dark']) .shot .for-light {
    display: none;
  }
  :global(:root[data-theme='dark']) .shot .for-dark {
    display: block;
  }
  /* The logo's escaping pixel, leaving the screenshot's corner. */
  .shot-pixel {
    position: absolute;
    top: -22px;
    right: -22px;
    width: 14px;
    height: 14px;
    /* Same tint as the frame it escaped from. */
    background: var(--line-strong);
  }

  /* ---- Sections ---- */
  section.install,
  section.features {
    padding-top: 120px;
  }
  section.install h2,
  section.features h2 {
    margin-top: 40px;
  }
  h3 {
    font-size: 18px;
    letter-spacing: -0.01em;
  }

  .install-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin-top: 40px;
  }
  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .card .btn {
    margin-top: auto;
  }
  /* Cards share their borders, like the feature grid. */
  .card + .card {
    border-left: 0;
  }
  .code {
    position: relative;
    width: 100%;
    margin-top: 4px;
    border-radius: var(--radius);
    background: var(--surface);
  }
  pre {
    margin: 0;
    padding: 16px 84px 16px 18px; /* room for the copy button */
    overflow-x: auto;
    font: 400 13px/1.7 var(--mono);
  }
  .copy {
    position: absolute;
    top: 10px;
    right: 10px;
    height: 28px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--bg);
    font: 500 12px/1 var(--mono);
    cursor: pointer;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 40px;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .feature {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px 28px 36px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  /*
   * Each card leads to its section of the Draw page, in that section's accent. The link is the
   * title (a clear link text), stretched over the whole card so all of it is clickable.
   */
  .feature {
    position: relative;
    color: var(--accent);
    /* The lift below comes in two pixel steps, not a glide. */
    transition-property: transform, box-shadow;
    transition-duration: 0.12s;
    transition-timing-function: steps(2, end);
  }
  @media (prefers-reduced-motion: reduce) {
    .feature {
      transition-property: none;
    }
  }
  /*
   * Hovered, the card lifts like a key, the reverse of the buttons that sink: it moves up and
   * left with a solid side in its accent. Pressed, it goes back down flat.
   */
  .feature:hover,
  .feature:focus-within {
    z-index: 1;
    background: linear-gradient(160deg, var(--tint-a), var(--tint-b));
    outline: 1px solid var(--accent);
    transform: translate(-4px, -4px);
    box-shadow: 4px 4px 0 var(--accent);
  }
  .feature:active {
    transform: none;
    box-shadow: none;
  }
  .feature h3 {
    margin-top: 12px;
    color: var(--text);
  }
  .feature h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .feature h3 a:focus-visible {
    outline: none;
  }
  .feature:has(a:focus-visible) {
    outline: 2px solid var(--text);
    outline-offset: -2px;
  }
  /* A pixel arrow in the corner, on hover. */
  .feature-arrow {
    position: absolute;
    top: 32px;
    right: 28px;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.15s,
      transform 0.15s;
  }
  .feature:hover .feature-arrow,
  .feature:focus-within .feature-arrow {
    opacity: 1;
    transform: none;
  }
  /*
   * Then it nudges right and back, in jumps like a game cursor rather than a glide.
   * Longhands: a shorthand animation can get minified to "none".
   */
  .feature:hover .feature-arrow :global(svg),
  .feature:focus-within .feature-arrow :global(svg) {
    animation-name: arrow-nudge;
    animation-duration: 0.8s;
    animation-timing-function: steps(1, end);
    animation-iteration-count: infinite;
  }
  @keyframes arrow-nudge {
    0% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(3px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .feature:hover .feature-arrow :global(svg),
    .feature:focus-within .feature-arrow :global(svg) {
      animation-name: none;
    }
  }
  .feature p {
    font-size: 15px;
  }

  /* ---- Small screens ---- */
  @media (max-width: 860px) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: 40px;
    }
    .install-grid,
    .feature-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .card + .card {
      border-left: 1px solid var(--line);
      border-top: 0;
    }
    .shot {
      margin-top: 40px;
      padding: 6px;
    }
    .shot-pixel {
      display: none;
    }
  }
</style>
