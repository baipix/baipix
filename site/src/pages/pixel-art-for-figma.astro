---
import CopySvgButton from '../components/CopySvgButton.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import GuideHero from '../components/GuideHero.astro';
import Nav from '../components/Nav.astro';
import PasteSteps from '../components/PasteSteps.astro';
import SectionHead from '../components/SectionHead.astro';
import Base from '../layouts/Base.astro';
import '../styles/guide.css';
import { galleryDoc } from '../gallery';
import { flatten } from '../../../src/engine/composite';
import { renderGeometry, toSvg } from '../../../src/engine/export/svg';

const base = import.meta.env.BASE_URL;

// The gallery's sheet of game icons, cut into its six icons. Each is drawn on its own as SVG for the
// mock-up, and the copied SVG has one group per icon, named, as a designer would want them in Figma.
const sheet = galleryDoc('items.baipix');
const sheetPixels = flatten(sheet, { includeBackground: false });
const CELL = 12;
const ICONS = [
  { name: 'Heart', x: 3, y: 3, count: 3 },
  { name: 'Coin', x: 17, y: 3, count: 128 },
  { name: 'Potion', x: 31, y: 3, count: 2 },
  { name: 'Key', x: 3, y: 17, count: 1 },
  { name: 'Sword', x: 17, y: 17, count: 1 },
  { name: 'Gem', x: 31, y: 17, count: 7 },
];
const icons = ICONS.map((icon) => {
  const px = new Uint32Array(CELL * CELL);
  for (let y = 0; y < CELL; y++)
    for (let x = 0; x < CELL; x++) px[y * CELL + x] = sheetPixels[(icon.y + y) * sheet.width + icon.x + x];
  const colors = new Set([...px].filter((c) => c >>> 24)).size;
  return { ...icon, px, colors, svg: toSvg(px, CELL, CELL, renderGeometry(CELL, CELL, 1, 0)) };
});
// What lands in Figma: the six icons side by side at 8×, each a named group of one shape per color.
const SCALE = 8;
const STEP = (CELL + 4) * SCALE;
const copied = [
  `<svg xmlns="http://www.w3.org/2000/svg" width="${STEP * icons.length - 4 * SCALE}" height="${CELL * SCALE}" viewBox="0 0 ${STEP * icons.length - 4 * SCALE} ${CELL * SCALE}" shape-rendering="crispEdges">`,
  ...icons.map((icon, i) => {
    const body = toSvg(icon.px, CELL, CELL, renderGeometry(CELL, CELL, SCALE, 0))
      .split('\n')
      .filter((line) => line.startsWith('<path'))
      .join('');
    return `<g id="${icon.name}" transform="translate(${i * STEP} 0)">${body}</g>`;
  }),
  '</svg>',
  '',
].join('\n');
const shapes = icons.reduce((n, icon) => n + icon.colors, 0);

const faq = [
  {
    q: 'Can you draw pixel art in Figma?',
    a: 'You can, with a grid of small squares, but Figma has no tools for it: no pencil that fills whole pixels, no palette, no dithering or symmetry, and hundreds of squares to manage. Drawing in a pixel art editor and pasting the result is much faster.',
  },
  {
    q: 'Is there a Baipix plugin for Figma?',
    a: 'Not yet. Copy as SVG in Baipix and paste in Figma works today, with nothing to install.',
  },
  {
    q: 'Can I edit the pixel art once it is in Figma?',
    a: 'You can recolor it, resize it and move its groups. To change the pixels themselves, edit the drawing in Baipix and paste it again.',
  },
  {
    q: 'Is Baipix free?',
    a: 'Yes. Baipix is free and open source (MIT). It runs in your browser, with no account, and your drawings stay on your device.',
  },
  {
    q: 'Can I start from a Figma design?',
    a: 'Yes. Export it from Figma as a PNG and import it in Baipix. If it was exported larger than its pixels, Baipix finds the pixel grid and gets the original pixels back.',
  },
];
---

<Base
  title="Pixel art for Figma · Draw it, paste it as vector | Baipix"
  description="Figma has no pixel art tools. Draw your pixel art in Baipix, a free editor that works like a design tool, then paste it into Figma as clean vector: one shape per color, layers as named groups."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  }}
>
  <Nav />

  <main class="guide" data-tone="layers">
    <GuideHero
      eyebrow="Pixel art for Figma"
      title="Pixel art for Figma"
      more={{ href: '#paste', text: 'How it works' }}
    >
      Figma has no tools for pixel art. Draw it in Baipix instead: a free pixel art editor that works like the
      design tools you know. Then paste it into Figma as vector you can edit.
    </GuideHero>

    <section class="demo container" aria-label="Pixel art icons in an app design">
      {/* A design as it would sit on a canvas: an app's inventory screen, its icons drawn in Baipix. */}
      <figure class="canvas" aria-label="An inventory screen designed with the six pixel art icons">
        <p class="canvas-frame-name">Inventory</p>
        <div class="screen">
          <div class="screen-head">
            <span>Inventory</span>
            <span class="screen-gold">
              <span class="pix" set:html={icons[1].svg} aria-hidden="true" />
              128
            </span>
          </div>
          <ul class="slots">
            {icons.map((icon) => (
              <li class="slot">
                <span class="pix" set:html={icon.svg} aria-hidden="true" />
                <span class="slot-name">{icon.name}</span>
                <span class="slot-count">×{icon.count}</span>
              </li>
            ))}
          </ul>
          <span class="screen-button">Use item</span>
        </div>
      </figure>
      <div class="demo-facts">
        <ul class="icon-groups" aria-label="The groups it gets in Figma">
          {icons.map((icon) => (
            <li>
              <span class="pix" set:html={icon.svg} aria-hidden="true" />
              {icon.name}
              <span class="muted">{icon.colors} shapes</span>
            </li>
          ))}
        </ul>
        <p class="muted">
          {`Six 12 × 12 icons from the gallery. Pasted in Figma, each is a group named after it, made of one shape per color: ${shapes} shapes in all, to recolor or resize like any vector.`}
        </p>
        <CopySvgButton svg={copied} />
      </div>
    </section>

    <PasteSteps title="Copy in Baipix, paste in Figma." />

    <section id="why" class="cards container">
      <SectionHead label="Why not in Figma" />
      <h2>What Figma doesn't do.</h2>
      <div class="card-grid">
        <article class="card">
          <h3>Whole pixels</h3>
          <p class="muted">
            Baipix's pencil fills whole pixels, with no doubled corners on curves. In Figma, each pixel is a
            square you place.
          </p>
        </article>
        <article class="card">
          <h3>A palette</h3>
          <p class="muted">
            Classic palettes, shades along a ramp, and a drawing moved to another palette in one step.
          </p>
        </article>
        <article class="card">
          <h3>Pixel art tools</h3>
          <p class="muted">
            Dithering, symmetry, seamless tiles, isometric volumes, and a fill that stays in the lines.
          </p>
        </article>
        <article class="card">
          <h3>Light files</h3>
          <p class="muted">
            What you paste is a shape per color, not a square per pixel: Figma stays fast, and no thin lines
            show between pixels.
          </p>
        </article>
      </div>
    </section>

    <section id="familiar" class="steps container">
      <SectionHead label="Familiar" />
      <h2>It works like Figma.</h2>
      <ol class="step-list familiar">
        <li>
          <div>
            <h3>Layers and boards</h3>
            <p class="muted">
              A layers panel with groups and blend modes, and several boards side by side in one file, like
              frames.
            </p>
          </div>
        </li>
        <li>
          <div>
            <h3>Components</h3>
            <p class="muted">
              Draw a sprite once, place instances of it, and they follow when you change it.
            </p>
          </div>
        </li>
        <li>
          <div>
            <h3>The same habits</h3>
            <p class="muted">
              V to move, Space to pan, Ctrl+K for every command, Shift-click to select several, and Export at
              the top right.
            </p>
          </div>
        </li>
      </ol>
      <p class="muted guide-more">
        More on the export itself in <a href={`${base}pixel-art-to-svg/`}>Pixel art to SVG</a>, and every tool
        on the <a href={`${base}draw/`}>Draw</a> page.
      </p>
    </section>

    <Faq items={faq} />

    <Cta />
  </main>

  <Footer />
</Base>

<style>
  /* A canvas with a frame on it: a light gray board, the frame's name above it, a phone-sized screen. */
  .canvas {
    display: grid;
    place-items: center;
    margin: 0;
    padding: 40px 24px;
    background:
      radial-gradient(circle at 1px 1px, light-dark(#d6d6d6, #2c2c2c) 1px, transparent 1.5px) 0 0 / 16px 16px,
      light-dark(#ececec, #1e1e1e);
  }
  .canvas-frame-name {
    justify-self: center;
    width: min(100%, 320px);
    margin: 0 0 6px;
    font-size: 12px;
    color: light-dark(#7a7a7a, #9a9a9a);
  }
  .screen {
    display: grid;
    gap: 16px;
    width: min(100%, 320px);
    padding: 20px;
    border-radius: 20px;
    background: #ffffff;
    color: #17171c;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.12);
    font-size: 13px;
  }
  .screen-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 17px;
    font-weight: 600;
  }
  .screen-gold {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px 4px 6px;
    border-radius: 999px;
    background: #f4f1e8;
    font-size: 13px;
  }
  .screen-gold .pix {
    width: 18px;
  }
  .slots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .slot {
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: 12px 6px 10px;
    border-radius: 12px;
    background: #f3f3f6;
  }
  .slot .pix {
    width: 40px;
  }
  .slot-name {
    font-weight: 500;
  }
  .slot-count {
    color: #7b7b86;
    font-size: 12px;
  }
  .screen-button {
    display: grid;
    place-items: center;
    height: 40px;
    border-radius: 12px;
    background: #17171c;
    color: #ffffff;
    font-weight: 600;
  }
  /* The groups it gets in Figma: each icon, its name, its shapes. */
  .icon-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
    list-style: none;
  }
  .icon-groups li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-weight: 500;
  }
  .icon-groups .pix {
    width: 28px;
  }
  .icon-groups .muted {
    margin-left: auto;
    font-size: 13px;
    font-weight: 400;
  }
  .familiar li {
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .guide-more {
    margin-top: 32px;
  }
  .guide-more a {
    color: var(--text);
    text-decoration: underline;
  }
</style>
