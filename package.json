{
  "name": "baipix",
  "version": "0.5.0",
  "description": "A pixel art editor for designers, with the interface of a modern design tool.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "pixelarticons": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.9.0",
    "vite": "^5.4.9",
    "vite-plugin-singlefile": "^2.0.2",
    "vitest": "^2.1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/baipix/baipix.git"
  },
  "keywords": [
    "pixel-art",
    "editor",
    "svg",
    "react",
    "typescript"
  ]
}
